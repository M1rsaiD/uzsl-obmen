+def _tiny_run_inp(mod, monkeypatch, out, *extra):
+    """_tiny_run с позой и H/W в записях (вход preprocess_u, --set sb)."""
+    def records(set_, fold, pose=False, inp=False):
+        rng = np.random.default_rng(0)
+        off = np.concatenate([[0], np.cumsum(rng.integers(8, 40, 96))])
+        xy = rng.uniform(0.2, 0.8, (off[-1], sohn.NUM_NODES_POSE, 2)).astype(np.float32)
+        clips = [{"sample_id": f"s{i}", "signer_id": f"p{i % 6}", "gloss": f"bukva:g{i % 4}"} for i in range(96)]
+        r = mod.Recs(xy[:, :118].copy(), np.zeros((off[-1], 4), bool), off, xy[:, 118:].copy() if (pose or inp) else None,
+                     np.full(96, 0.5625, np.float32) if inp else None)
+        return r, [c["gloss"] for c in clips], clips, (list(range(64)), list(range(64, 80)), [])
+    monkeypatch.setattr(mod, "records", records)
+    for k, v in (("batch_size", 64), ("awp_start_epoch", 1), ("dropout_start_epoch", 2)):
+        monkeypatch.setitem(sohn.CFG, k, v)
+    monkeypatch.setenv("WEEKEND_GATE_NOW", "2026-11-10 10:00")
+    mod.main(["--set", "sb", "--seed", "1", "--epochs", "4", "--max-steps", "3", "--workers", "1", "--out", str(out), *extra])
+    return out
