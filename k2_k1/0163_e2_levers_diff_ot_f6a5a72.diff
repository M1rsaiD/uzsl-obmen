+def _tiny_run(mod, monkeypatch, out, *extra, gloss=lambda i: f"g{i % 4}"):
+    """mod.main (m13_train) на 96 синтетических записях без данных ПК: Bukva, режим fold (val каждую эпоху, best.pt по val_loss),
+    пакет 64 = 8 × 8, расписание на 4 эпохи по шагу, обрыв после 3 шагов (--max-steps), AWP с шага 1, late dropout с шага 2; ЦП.
+    gloss(i) — глосса записи i (train — 0…63, val — 64…79, тест — 80…95)."""
+    def records(set_, fold, pose=False, inp=False):
+        rng = np.random.default_rng(0)
+        off = np.concatenate([[0], np.cumsum(rng.integers(8, 40, 96))])
+        xy = rng.uniform(0.2, 0.8, (off[-1], sohn.NUM_NODES, 2)).astype(np.float32)
+        clips = [{"sample_id": f"s{i}", "signer_id": f"p{i % 6}", "gloss": gloss(i)} for i in range(96)]
+        return (mod.Recs(xy, np.zeros((off[-1], 4), bool), off), [c["gloss"] for c in clips], clips,
+                (list(range(64)), list(range(64, 80)), list(range(80, 96))))
+    monkeypatch.setattr(mod, "records", records)
+    for k, v in (("batch_size", 64), ("awp_start_epoch", 1), ("dropout_start_epoch", 2)):
+        monkeypatch.setitem(sohn.CFG, k, v)
+    monkeypatch.setenv("WEEKEND_GATE_NOW", "2026-11-10 10:00")              # будний день: weekend_gate.sh не ждёт
+    mod.main(["--set", "bukva", "--fold", "fold1", "--seed", "1", "--epochs", "4", "--max-steps", "3", "--workers", "1", "--out", str(out),
+              *extra])
+    return out
