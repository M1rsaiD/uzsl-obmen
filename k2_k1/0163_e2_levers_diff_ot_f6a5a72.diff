+def test_e2_ema_decay_by_steps_and_warmup():
+    """(б) decay — по полному бюджету прогона в шагах: 0,999 при total ≥ 3 000, иначе 0,99 (= configs/common.yaml, где прогрев
+    выключен); прогрев M9.7 включён: 1 000 обновлений = ручная рекурсия с mpk.train.ema_decay_at (шаг 1 — копия, t — число уже
+    усреднённых шагов) и ≠ рекурсии с другим decay (различаются с t = 890)."""
+    import yaml
+    from mpk.train import ema_decay_at
+    T_ = _m13()
+    tc = yaml.safe_load((Path(__file__).resolve().parents[1] / "configs/common.yaml").read_text())["train"]
+    assert (tc["ema_decay"], tc["ema_decay_short"], tc["ema_short_below"], tc["ema_warmup"]) == (0.999, 0.99, 3000, False)
+    w = torch.randn(1000, generator=torch.Generator().manual_seed(0))
+    for total, d in ((1500, 0.99), (2999, 0.99), (3000, 0.999), (10_500, 0.999)):
+        lin = torch.nn.Linear(1, 1, bias=False)
+        e = T_.sohn_ema(lin, total)
+        ref = {0.99: None, 0.999: None}
+        for t in range(1000):
+            with torch.no_grad():
+                lin.weight.fill_(w[t])
+            e.update_parameters(lin)
+            for k, r in ref.items():
+                ref[k] = lin.weight.detach().clone() if r is None else torch.lerp(r, lin.weight.detach(), 1 - ema_decay_at(k, t))
+        assert torch.equal(e.module.weight, ref[d]) and not torch.equal(ref[0.99], ref[0.999]), total
