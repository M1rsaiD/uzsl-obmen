+def test_e2_long_tail_init_resets_scale(tmp_path, monkeypatch):
+    """№ 4 с --init (вне Э2, вариант (II): предобучение с № 4 → дообучение с № 4): s косинусной головы на старте дообучения — 16
+    (22.11 «s = 16 со старта»: масштаб — часть головы, а голова новая), остальное — из весов; у прежнего флага идеи 7 (--variant 7)
+    s — из весов, как в master."""
+    T_ = _m13()
+    pre = _tiny_run(T_, monkeypatch, tmp_path / "pre", "--balanced")
+    w = torch.load(pre / "best.pt")["model"]
+    assert float(w["cos_scale"]) != 16.0
+    m0 = json.loads((pre / "metrics.json").read_text())
+    (pre / "metrics.json").write_text(json.dumps({**m0, "steps_run": 13800, "steps": 13800, "epochs": 300}))   # бюджет — как полный
+    old = tmp_path / "old" / "best.pt"                                       # без metrics.json: у идеи 7 проверки --init нет
+    old.parent.mkdir()
+    old.write_bytes((pre / "best.pt").read_bytes())
+    st, step0 = [], sohn.train_step
+
+    def step(model, *a, **k):
+        st.append({n: t.detach().clone() for n, t in model.state_dict().items()})
+        return step0(model, *a, **k)
+    monkeypatch.setattr(sohn, "train_step", step)
