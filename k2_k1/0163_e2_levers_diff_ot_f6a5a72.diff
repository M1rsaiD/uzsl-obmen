+    P = NUM_NODES_POSE if "u01a" in tokens else NUM_NODES
+    cols, o = [_cols(p, P) for p in part_points(tokens)], 6 * P
+    for t, n in (("u04", HAND_FEATS // 2), ("u01b", HAND_LOCAL // 2)):   # порядок — как в preprocess_u
