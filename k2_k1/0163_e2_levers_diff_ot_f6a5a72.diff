+def test_e2_long_tail_sampling():
+    """(б) № 4, выборка — вариант (II) (к1 0142, к3 0043): 50 000 выборок потока (затравка 48) — частоты классов внутри набора равны
+    (|z| < 4 от биномиальной), доля набора в S+B — как без № 4, т. е. доля записей train (|z| < 4 у обоих потоков); n и число классов —
+    по записям train (записи вне train — 100 записей хвостового класса и класс без записей train — не в счёт); без № 4 хвостовой класс
+    в потоке в десятки раз реже; не S+B — один набор. (в) Шагов, пакетов и позиций (затравок аугментаций) — столько же, что без № 4.
+    (а) Без p поток = Stream master бит в бит."""
+    import math
+    from collections import Counter
+    import pytest
+    T_, base = _m13(), _sohn_at(MASTER_E2, "scripts/m13_train.py")
+    cnt = {"slovo": [1, 2, 3, 5, 8, 12, 20, 30, 50, 80, 120, 200], "bukva": [10, 15, 20, 30, 50]}   # хвост 1…200 / 10…50
+    gl = [f"{d}:c{k}" for d, ns in cnt.items() for k, n in enumerate(ns) for _ in range(n)]
+    N = len(gl)
+    gl += ["slovo:c0"] * 100 + ["slovo:x"] * 5                                  # вне train (как val)
+    names = sorted(set(gl))
+    labels = np.array([names.index(g) for g in gl])
+    train = [int(i) for i in np.random.default_rng(1).permutation(N)]
+    assert list(T_.Stream(train, 7, 48, 64, 300)) == list(base.Stream(train, 7, 48, 64, 300))
+    p = T_.balanced_p(train, labels, gl, "sb")
+    tot = np.bincount(labels[train], weights=p, minlength=len(names))
+    for d, ns in cnt.items():                                                   # точно: класс — доля набора / число его классов
+        assert np.allclose(tot[[names.index(f"{d}:c{k}") for k in range(len(ns))]], sum(ns) / N / len(ns), rtol=1e-12, atol=0)
+    one = np.bincount(labels[train], weights=T_.balanced_p(train, labels, gl, "alluz"), minlength=len(names))
+    assert np.allclose(one[tot > 0], 1 / 17, rtol=1e-12, atol=0)                # не S+B — один набор: 17 классов поровну
+    with pytest.raises(AssertionError):                                         # S+B без префикса набора — отказ, не молча
+        T_.balanced_p([0, 1], np.array([0, 1]), ["a", "b"], "sb")
+    S = 50_000
+    st, plain = T_.Stream(train, 100, 48, 500, 32768, p), T_.Stream(train, 100, 48, 500, 32768)
+    draw, d0 = list(st), list(plain)
+    assert len(st) == len(draw) == len(d0) == 100 and all(len(b) == 500 for b in draw)
+    assert [q for b in draw for _, q in b] == [q for b in d0 for _, q in b] == list(range(S))
+    c, c0 = Counter(gl[i] for b in draw for i, _ in b), Counter(gl[i] for b in d0 for i, _ in b)
+    for d, ns in cnt.items():
+        share = sum(ns) / N
+        for cc in (c, c0):
+            got = sum(v for g, v in cc.items() if g.startswith(d))
+            assert abs(got - S * share) < 4 * math.sqrt(S * share * (1 - share)), (d, got, S * share)
+        e = S * share / len(ns)
+        z = [(c[f"{d}:c{k}"] - e) / math.sqrt(e * (1 - e / S)) for k in range(len(ns))]
+        assert max(map(abs, z)) < 4, (d, z)
+    assert c0["slovo:c0"] * 20 < c["slovo:c0"] and "slovo:x" not in c
