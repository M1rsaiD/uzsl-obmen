+def balanced_p(train: list[int], labels: np.ndarray, glosses: list[str], set_: str) -> np.ndarray:
+    """№ 4 Э2 турнира (поправка 4, 22.11; вне Э2 — вариант (II), к1 0142, к3 0043): вероятности записей train в потоке — классы
