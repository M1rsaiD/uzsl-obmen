+    ft, v7 = st[0], st[3]                                                    # до первого шага каждого прогона (3 шага)
+    assert float(ft["cos_scale"]) == 16.0 and float(v7["cos_scale"]) == float(w["cos_scale"])
+    assert all(torch.equal(s[k], w[k]) for s in (ft, v7) for k in w if not k.startswith(("classifier.", "cos_scale")))
