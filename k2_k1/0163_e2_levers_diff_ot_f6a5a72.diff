+    или Bukva у S+B (префикс глоссы, records), иначе один (корпус — по фолду)."""
+    lab = labels[train]
+    grp = np.array([glosses[i].split(":")[0] if set_ == "sb" else "" for i in train])
+    assert set_ != "sb" or set(grp) <= {"slovo", "bukva"}, set(grp)   # без префикса каждый класс стал бы своим набором — молча без баланса
+    n = np.bincount(lab)[lab]
