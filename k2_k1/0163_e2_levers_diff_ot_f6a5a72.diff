+def test_e2_long_tail_cos_head_awp():
+    """(г) № 4, косинусная голова: s = 16 со старта и обучается; без отступа и смещения — classifier.bias не обучается (нет в RAdam и
+    AWP) и не меняется (0,5 до и после); |логит| ≤ s; 3 шага sohn.train_step (2 с AWP) на ЦП без падения — на входе Sohn и поверх
+    № 2 (токены частей, U04 + U01b). Регрессия А4 (levers_code.out): в master шаг AWP с cos_head падал; без AWP — веса как в master
+    бит в бит."""
+    import pytest
+    for kw in ({}, {"part_tokens": True, "tokens": ("u04", "u01b")}):
+        tok = kw.get("tokens", ())
+        feat = (lambda x: _feat2(x, tok)) if kw else (lambda x: sohn.preprocess(x[:, :118]))
+        parts = []
+        for p in range(2):
+            xx, mm = sohn.collate([feat(_rec122(T=T, seed=p * 10 + T)) for T in (20, 30)])
+            parts.append((xx, mm, torch.tensor([p, p + 1])))
+        torch.manual_seed(0)
+        m = sohn.SohnNet(7, channels=sohn.input_channels(tok), cos_head=True, **kw).train()
+        assert float(m.cos_scale.detach()) == 16.0 and not m.classifier.bias.requires_grad and m.classifier.weight.requires_grad
+        with torch.no_grad():
+            m.classifier.bias.fill_(0.5)                     # не 0: затухание весов RAdam сдвинуло бы его, будь он в оптимизаторе
+        opt = sohn.RAdamLookahead(m.parameters())
+        assert all(q is not m.classifier.bias for q in opt.params)
+        w0 = m.classifier.weight.detach().clone()
+        for s in range(3):
+            assert np.isfinite(sohn.train_step(m, opt, parts, 1e-3, 1e-4, awp_on=s > 0))
+        assert torch.equal(m.classifier.bias, torch.full((7,), 0.5)) and float(m.cos_scale.detach()) != 16.0
+        assert not torch.equal(w0, m.classifier.weight)
+        with torch.no_grad():
+            y = m.eval()(*parts[0][:2])
+        assert y.abs().max() <= float(m.cos_scale.detach()) + 1e-4
+    old = _sohn_at(MASTER_E2)
