+def test_stage2_chain_runs(tmp_path):
+    """Цепочка этапа 2 исполняется в tmp с заглушками PATH (systemctl, systemd-run, pgrep, nvidia-smi, sleep) и UZSOHN_PY: ждёт
+    маркер группы 1 (печать «жду» с M13 и маркером сверки), затем окно (а): нет маркера сверки → выход 0 и M13 сразу (trap); M13
+    активна → выход 0 без U01b и без нового юнита; M13 завершена → выход 0, юнит не запускается; ошибка после маркера («!!!») →
+    выход 1 и M13 (trap). Обучение не запускается ни в одной ветке; настоящие юниты и ГП не трогаются."""
+    import shutil
+    import subprocess
+    src = Path(__file__).resolve().parents[1] / "scripts/uzsohn_stage2_chain.sh"
+    stub, calls, act = tmp_path / "stub", tmp_path / "calls.log", tmp_path / "m13_active"
+
+    def put(name, body):
+        (stub / name).write_text("#!/usr/bin/env bash\n" + body + "\n")
+        (stub / name).chmod(0o755)
+    stub.mkdir()
+    put("systemctl", f'echo "systemctl $*" >> {calls}\n[ "$2" = is-active ] && exit $(cat {act})\nexit 0')
+    put("systemd-run", f'echo "systemd-run $*" >> {calls}')
+    put("pgrep", "exit 1")
+    put("nvidia-smi", "exit 0")                                        # ГП без python
+    put("sleep", "touch runs/TURNIR_E1_g1.done")                       # первый сон — конец группы 1
+    put("fakepy", f'echo "PY $*" >> {calls}\ncase "$1" in -c) exit 0;; esac\nexit 2')
+    env = {"PATH": f"{stub}:/usr/bin:/bin", "HOME": str(tmp_path), "UZSOHN_PY": str(stub / "fakepy")}
+    assert all(shutil.which(t, path=env["PATH"]) == str(stub / t) for t in ("systemctl", "systemd-run", "pgrep", "nvidia-smi", "sleep"))
+    for name, active, marker, done, rc, says, m13_started in (
+            ("no_ok", 3, False, False, 0, "окно (а) пропущено: нет runs/UZSOHN_STAGE2_OK", True),
+            ("m13_on", 0, True, False, 0, "окно (а) пропущено: юнит m13-sohn-2 активен", False),
+            ("m13_done", 3, True, True, 0, "окно (а) пропущено: M13 уже завершена", False),
+            ("error", 3, True, False, 1, "!!! нет списка кода этапа", True)):
+        om = tmp_path / name
+        (om / "scripts").mkdir(parents=True)
+        (om / "runs").mkdir()
+        shutil.copy(src, om / "scripts")
+        if marker:
+            (om / "runs/UZSOHN_STAGE2_OK").write_text("0" * 40 + "\n")
+        if done:
+            (om / "runs/UzSohn_M13.done").touch()
+        act.write_text(str(active))
+        calls.write_text("")
+        r = subprocess.run(["bash", "scripts/uzsohn_stage2_chain.sh"], cwd=om, env=env, capture_output=True, text=True, timeout=60)
+        c = calls.read_text()
+        assert r.returncode == rc and says in r.stdout and "жду: TURNIR_E1_g1.done=нет" in r.stdout, (name, r.stdout, r.stderr)
+        assert f"UZSOHN_STAGE2_OK={'да' if marker else 'нет'}, m13-sohn-2 активен={'да' if active == 0 else 'нет'}" in r.stdout, name
+        assert c.count("systemd-run --user --unit=m13-sohn-2") == m13_started and "m13_train" not in c and "-m pytest" not in c, (name, c)
+        assert ("юнит m13-sohn-2 запущен" in r.stdout) == m13_started and (om / "runs/TURNIR_E1_g1.done").is_file(), name
