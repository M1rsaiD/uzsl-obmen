+#!/usr/bin/env bash
+# UzSohn, этап 2 — U01b (reports/UZSOHN_prereg_popravka2.md; определение — 0153 + к1 0136 п. 5, к3 0039 разд. 5). Решение автора
+# 16.11 «давай всё попробуем», толкование к2: окно (а) — после группы 1 турнира, до M13 (M13 и группа 2 сдвигаются ≈ 7 ч).
+# До ожидания: интерпретатор, runs/UZSOHN_stage2.done (есть — выход). Ждёт runs/TURNIR_E1_g1.done и 3 мин подряд без python на ГП
+# (как m13_chain_v4.sh, урок 27); M13 в ожидании не проверяется — к2 останавливает её после старта этого юнита (строка «жду» её
+# показывает). Окно (а) решается после ожидания (Поправка 2, 4.2 п. 4): нет runs/UZSOHN_STAGE2_OK (1-я строка — полный хеш
+# сверенного коммита), m13-sohn-2 активен или M13 уже завершена (runs/UzSohn_M13.done) — выход без U01b. Иначе: код этапа
+# (scripts/uzsohn_code.txt) и предрег. с поправками 1–2 закоммичены и = хешу маркера, текст цепочки = HEAD → нет CUDA — стоп →
+# селфтест (ЦП) → этап 1 завершён и ничего не принял (U01b — поверх Sohn) → своё предобучение S+B sb_in_u01b (затравка 48, одна
+# повторная попытка) → отбор U01b на 10 V_k ALL-UZ (затравка 48, по 2 прогона) → uzsohn_sel.py decide против контроля этапа 1
+# uzsohn_sel_alluz_v0 (Δ macro ≥ 1,008 п. п. и лучше у ≥ 6/10 V_k) → report2 → reports/UZSOHN_stage2.md → runs/UZSOHN_stage2.done
+# → СТОП. Подтверждение (3 затравки на S_k) сюда не входит — только по решению автора. При любом выходе — успех, пропуск окна,
+# ошибка, остановка юнита (trap EXIT) — запускает юнит m13-sohn-2 (m13_chain_v4.sh), если он не активен и нет runs/UzSohn_M13.done
+# (SIGKILL — без trap: тогда M13 — вручную, шапка m13_chain_v4.sh). Готовое пропускается. Ошибки — строки «!!!». Интерпретатор —
+# каталог mise 3.14.7 (урок 30; UZSOHN_PY — замена). Править этот файл — только при остановленном юните: тело — функция main,
+# после ожидания текст сверяется с HEAD. Запуск — до TURNIR_E1_g1.done: (1) юнит этапа 2 (он ждёт); (2) затем M13 — стоп, только
+# пока юнит этапа 2 идёт, а M13 ждёт (последняя строка runs/m13_chain.log — «… жду ГП …», m13_train.py не идёт):
+#   cd ~/uzsign/osnovnaya_model && systemd-run --user --unit=uzsohn-stage2 --collect -p WorkingDirectory=$PWD -p MemoryMax=40G \
+#     -p MemorySwapMax=0 -E PATH="$PATH" -E HOME="$HOME" bash -c "bash scripts/uzsohn_stage2_chain.sh >> runs/uzsohn_stage2_chain.log 2>&1"
+#   cd ~/uzsign/osnovnaya_model && systemctl --user is-active --quiet uzsohn-stage2 && tail -1 runs/m13_chain.log | grep -q 'жду ГП' \
+#     && ! pgrep -f 'scripts/[m]13_train.py' > /dev/null && systemctl --user stop m13-sohn-2
+main() {   # всё тело — функция: bash разбирает файл целиком до запуска
+set -u
+cd "$(dirname "$0")/.."
+H0=$(git hash-object scripts/uzsohn_stage2_chain.sh)
+UZ2=$PWD/../uzsign_ai_v2
+PY=${UZSOHN_PY:-$HOME/.local/share/mise/installs/python/3.14.7/bin/python}
+export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
+export PYTHONPATH=src:../uzsign_e1/src:../uzsign_ai_v2/src
+say() { echo "[$(date '+%F %T')] $*"; }
+keep() { [ -f "$1" ] && mv "$1" "$1.$(date +%Y%m%dT%H%M%S)"; return 0; }
+gpu_busy() { nvidia-smi --query-compute-apps=process_name --format=csv,noheader 2>/dev/null | grep -q python; }
+busy() { [ -f runs/TURNIR_E1_g1.done ] || return 0; gpu_busy; }   # как m13_chain_v4.sh: до маркера группы 1 — ждать
+m13_on() { systemctl --user is-active --quiet m13-sohn-2 || pgrep -f "bash scripts/m13_chain_v" > /dev/null; }
+m13_stop() { m13_on && { say "!!! юнит m13-sohn-2 активен (или идёт bash scripts/m13_chain_v*) перед ГП этапа 2 — стоп, M13 не трогаю"; exit 1; }; return 0; }
+m13_back() {   # trap EXIT: ГП — M13 (m13_chain_v4.sh сама ждёт TURNIR_E1_g1.done и 3 мин свободной ГП)
+  m13_on && return 0
+  [ -f runs/UzSohn_M13.done ] && return 0
+  systemd-run --user --unit=m13-sohn-2 --collect -p WorkingDirectory="$PWD" -p MemoryMax=40G -p MemorySwapMax=0 -E PATH="$PATH" \
+    -E HOME="$HOME" bash -c "bash scripts/m13_chain_v4.sh >> runs/m13_chain.log 2>&1" \
+    && say "юнит m13-sohn-2 запущен (m13_chain_v4.sh)" || say "!!! юнит m13-sohn-2 не запущен — запустить вручную (шапка m13_chain_v4.sh)"
+}
+trap m13_back EXIT
+trap "exit 143" TERM INT
+J=${UZSOHN_JOBS_U01B:-2}   # как U04 (UZSOHN_prereg разд. 7; у U01b 792 столбца против 1 158 у U04)
+SEED=48                    # отбор целиком на 48 (UZSOHN_prereg разд. 5)
+SET=alluz; TOK=u01b; CTRL=uzsohn_sel_alluz_v0; PRE=sb_in_u01b; TAG=uzsohn_sel_alluz_in_u01b
+P2=reports/UZSOHN_prereg_popravka2.md
+PREREG="reports/UZSOHN_prereg.md reports/UZSOHN_prereg_popravka1.md $P2"
+mkdir -p runs/UzSohn/logs runs/UZSOHN
+say "=== UzSohn этап 2 (U01b): старт, жду TURNIR_E1_g1.done и 3 мин подряд без python на ГП"
+$PY -c "import numpy, torch, pytest" 2> /dev/null || { say "!!! в $PY нет numpy/torch/pytest (UZSOHN_PY) — стоп до ожидания"; exit 1; }
+[ -f runs/UZSOHN_stage2.done ] && { say "этап 2 уже завершён (runs/UZSOHN_stage2.done) — выход до ожидания"; exit 0; }
+n=0
+while true; do   # как m13_chain_v4.sh:44–48
+  while busy; do
+    [ $((n % 60)) -eq 0 ] && say "жду: TURNIR_E1_g1.done=$([ -f runs/TURNIR_E1_g1.done ] && echo да || echo нет), ГП занята (python)=$(gpu_busy && echo да || echo нет); UZSOHN_STAGE2_OK=$([ -f runs/UZSOHN_STAGE2_OK ] && echo да || echo нет), m13-sohn-2 активен=$(m13_on && echo да || echo нет)"
+    n=$((n + 1)); sleep 60
+  done
+  ok=1; for i in 1 2 3; do sleep 60; busy && { ok=0; break; }; done
+  [ $ok = 1 ] && break
+done
+[ -f runs/UZSOHN_stage2.done ] && { say "этап 2 уже завершён — выход"; exit 0; }
+# окно (а) — только сейчас (Поправка 2, 4.2 п. 4); выход — ГП юниту M13 (trap)
+[ -f runs/UZSOHN_STAGE2_OK ] || { say "окно (а) пропущено: нет runs/UZSOHN_STAGE2_OK (сверки нет) — выход, ГП — M13"; exit 0; }
+m13_on && { say "окно (а) пропущено: юнит m13-sohn-2 активен (его не остановили) — M13 первой, выход"; exit 0; }
+[ -f runs/UzSohn_M13.done ] && { say "окно (а) пропущено: M13 уже завершена (runs/UzSohn_M13.done), дальше ГП турнира — выход"; exit 0; }
+# код — только закоммиченный и = хешу сверенного коммита (1-я строка маркера); список — scripts/uzsohn_code.txt (как у этапа 1)
+CODE=$(sed 's/#.*//' scripts/uzsohn_code.txt 2> /dev/null | grep -v '^ *v2:' | xargs)
+V2CODE=$(sed 's/#.*//' scripts/uzsohn_code.txt 2> /dev/null | grep '^ *v2:' | sed 's/^ *v2://' | xargs)
+[ -n "$CODE" ] && [ -n "$V2CODE" ] || { say "!!! нет списка кода этапа (scripts/uzsohn_code.txt) — стоп"; exit 1; }
+for p in $PREREG; do [ -f $p ] || { say "!!! нет $p (предрегистрация и поправки 1–2) — стоп"; exit 1; }; done
+[ -z "$(git status --porcelain -- $CODE $PREREG)" ] || { say "!!! незакоммиченный код или предрегистрация: $(git status --porcelain -- $CODE $PREREG | tr '\n' ' ')— стоп"; exit 1; }
+OKH=$(head -1 runs/UZSOHN_STAGE2_OK | grep -oE '^[0-9a-f]{40}')
+[ -n "$OKH" ] || { say "!!! в 1-й строке runs/UZSOHN_STAGE2_OK нет полного хеша сверенного коммита — стоп"; exit 1; }
+git diff --quiet "$OKH" HEAD -- $CODE $PREREG || { say "!!! код ($CODE) или $PREREG ≠ сверенному хешу $OKH (или хеш неверен) — стоп"; exit 1; }
+[ "$H0" = "$(git rev-parse HEAD:scripts/uzsohn_stage2_chain.sh 2> /dev/null)" ] || { say "!!! scripts/uzsohn_stage2_chain.sh изменена после старта юнита (исполняется копия со старта, $H0) — перезапустить юнит; стоп"; exit 1; }
