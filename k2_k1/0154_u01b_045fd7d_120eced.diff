+def test_stage2_chain_guards():
+    """Цепочка этапа 2: тело — функция main (вызов и exit — последней строкой); trap EXIT (возврат ГП юниту M13) — до ожидания;
+    ожидание — маркер группы 1 и 3 мин подряд без python на ГП (как m13_chain_v4.sh); окно (а) решается после ожидания (маркер
+    сверки, M13 активна, M13 завершена), затем код = хешу маркера по предрег. и поправкам 1–2, текст = HEAD, селфтест, M13 активна —
+    стоп перед ГП; U01b — затравка 48, своё предобучение, решение против контроля этапа 1."""
+    ch = (Path(__file__).resolve().parents[1] / "scripts/uzsohn_stage2_chain.sh").read_text()
+    L = ch.rstrip("\n").split("\n")
+    assert L[-1] == 'main "$@"; exit' and L[-2] == "}" and sum(s.startswith("main() {") for s in L) == 1
+    w = ch.index("while busy; do")
+    assert ch.index("H0=$(git hash-object scripts/uzsohn_stage2_chain.sh)") < ch.index("trap m13_back EXIT") < w
+    assert "busy() { [ -f runs/TURNIR_E1_g1.done ] || return 0; gpu_busy; }" in ch and "for i in 1 2 3; do sleep 60; busy" in ch
+    ok = ch.index("[ -f runs/UZSOHN_STAGE2_OK ] ||")
+    assert w < ok < ch.index("m13_on && {", ok) < ch.index("[ -f runs/UzSohn_M13.done ] &&", ok) < ch.index("git diff --quiet \"$OKH\"")
+    assert ch.index("git diff --quiet \"$OKH\"") < ch.index('[ "$H0" = "$(git rev-parse HEAD:scripts/uzsohn_stage2_chain.sh') < ch.index("selftest_stage2.log")
+    assert ch.rindex("m13_stop", 0, ch.index("pretrain()")) > ch.index("selftest_stage2.log")
+    assert 'PREREG="reports/UZSOHN_prereg.md reports/UZSOHN_prereg_popravka1.md $P2"' in ch
+    assert "SEED=48 " in ch and "--set sb --seed $SEED --tag $PRE --input $TOK" in ch and "decide $CTRL $TAG U01b" in ch
+    assert "CTRL=uzsohn_sel_alluz_v0; PRE=sb_in_u01b; TAG=uzsohn_sel_alluz_in_u01b" in ch and "report2 $CTRL $TAG" in ch
+    assert "--unit=m13-sohn-2" in ch and 'bash -c "bash scripts/m13_chain_v4.sh >> runs/m13_chain.log 2>&1"' in ch
+    assert "--unit=uzsohn-stage2" in ch and "pgrep -f 'scripts/[m]13_train.py'" in ch
+
