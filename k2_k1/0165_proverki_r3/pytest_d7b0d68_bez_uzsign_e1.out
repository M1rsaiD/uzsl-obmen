    def test_x_ema_every_step_not_every_epoch(tmp_path, monkeypatch):
        """№ 3: EMA обновляется на КАЖДОМ шаге — при 2 шагах на эпоху (пакет 32 = 8 × 4) n_averaged = числу шагов."""
        T_ = _m13()
        made = []
    
        class Spy(torch.optim.swa_utils.AveragedModel):
            def __init__(self, *a, **k):
                super().__init__(*a, **k)
                made.append(self)
        monkeypatch.setattr(torch.optim.swa_utils, "AveragedModel", Spy)
        monkeypatch.setitem(sohn.CFG, "batch_size", 32)
        for k, v in (("awp_start_epoch", 1), ("dropout_start_epoch", 2)):
            monkeypatch.setitem(sohn.CFG, k, v)
        def records(set_, fold, pose=False, inp=False):
            rng = np.random.default_rng(0)
            off = np.concatenate([[0], np.cumsum(rng.integers(8, 40, 96))])
            xy = rng.uniform(0.2, 0.8, (off[-1], sohn.NUM_NODES, 2)).astype(np.float32)
            clips = [{"sample_id": f"s{i}", "signer_id": f"p{i % 6}", "gloss": f"g{i % 4}"} for i in range(96)]
            return (T_.Recs(xy, np.zeros((off[-1], 4), bool), off), [c["gloss"] for c in clips], clips,
                    (list(range(64)), list(range(64, 80)), list(range(80, 96))))
        monkeypatch.setattr(T_, "records", records)
        monkeypatch.setenv("WEEKEND_GATE_NOW", "2026-11-10 10:00")
