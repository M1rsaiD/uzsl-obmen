+    пропусков (каждый — «!!!»); ничего не считает и не пишет."""
+    miss = 0
+    for c in te.C:
+        if c["kind"] != "m13" or c["ds"] == te.LO or (only and c["ds"] != only):
+            continue
+        for d in first_dirs(c):
