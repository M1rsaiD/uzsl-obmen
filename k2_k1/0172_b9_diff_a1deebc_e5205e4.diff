+"""Б9 (поправка 4 к TURNIR_prereg, 22.10 п. 5): выгрузка ВАЛИДАЦИИ прогонов M13 и UzSohn на протоколе П (Slovo, Bukva) по best.pt
+на ЦП — для «толпы Sohn»: состав смешанного ансамбля выбирается по валидации (turnir_eval.summary → choose_mixed), а m13_train
+пишет вероятности только теста (probs.npz). Тест здесь не читается и не считается: из каталога прогона — best.pt, log.csv (val_top1
+эпохи best.pt — сверка) и ключи сети metrics.json (NET); предсказываются только записи валидации фолда (m13_train.records).
+Источники и порядок — ячейки стенда (turnir_eval.C, kind m13, без корпуса — там состав вложенный LOSO): у пары (фолд, затравка)
+берётся тот же каталог, что у export_cell (первый в src_dirs с probs.npz и metrics.json; файлы теста не открываются).
+Выход — runs/TURNIR/preds/<набор>/<модель>/native/scratch/<фолд>__val__seed<k>.npz (формат стенда, role = 'val'; load_model(…,
+'val') читает его как фолд «<фолд>__val», в тестовых строках он не участвует) + val_export.json (откуда, sha256 best.pt, сверка).
+cd osnovnaya_model
+CUDA_VISIBLE_DEVICES= nice -n 19 PYTHONPATH=src:../uzsign_e1/src python scripts/turnir_val_m13.py [--threads 8] [--dataset Slovo]
+"""
+import argparse
+import csv
+import functools
+import inspect
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import turnir_eval as te  # noqa: E402
+
+NET = ("set", "fold", "seed", "flags", "input", "channels", "arch")  # ключи metrics.json, что читаются (сеть и фолд; top-1 — нет)
+
+
+def net_meta(d: Path) -> dict:
+    m = json.loads((d / "metrics.json").read_text())
+    return {k: m.get(k) for k in NET}
+
+
+@functools.lru_cache(maxsize=1)
+def _records(set_: str, fold: str, pose: bool, inp: bool):
+    import m13_train as mt
+    return mt.records(set_, fold, pose=pose, inp=inp)
+
+
+def val_logits(d: Path, threads: int) -> dict:
+    """Логиты best.pt на валидации фолда прогона d — тем же predict, что валидация при обучении (ЦП, float32)."""
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""
+    import torch
+    import m13_train as mt
+    from mpk import sohn
+    torch.set_num_threads(threads)
+    m = net_meta(d)
+    assert m["set"] in ("slovo", "bukva") and (m["arch"] or "sohn") == "sohn", (d, m["set"], m["arch"])
+    tokens, flags = tuple(m["input"] or ()), m["flags"] or {}
+    assert m["channels"] in (None, sohn.input_channels(tokens)), (d, m["channels"])
+    ck = torch.load(d / "best.pt", map_location="cpu")
+    names = list(ck["names"])
+    recs, glosses, clips, split = _records(m["set"], m["fold"], bool(flags.get("pose")), bool(tokens))
+    va = split[1]  # только валидация; split[2] (тест) не используется
+    recs.tokens = tokens
+    lab = {g: k for k, g in enumerate(names)}
+    labels = np.full(len(recs), -1, np.int64)
+    labels[va] = [lab[glosses[i]] for i in va]
+    kw = {"tokens": tokens} if "tokens" in inspect.signature(sohn.SohnNet).parameters else {}  # как m13_train ветки рычагов
+    model = sohn.SohnNet(len(names), sohn.CFG["dim"], channels=sohn.input_channels(tokens), **flags, **kw)
+    model.load_state_dict(ck["model"])
+    z, _ = mt.predict(model, recs, labels, va, torch.device("cpu"), sohn.CFG["label_smoothing"])
+    with open(d / "log.csv", newline="") as f:
+        log = {int(r["epoch"]): r["val_top1"] for r in csv.DictReader(f)}
+    return dict(ids=np.array([clips[i]["sample_id"] for i in va]), logits=z, names=names,
+                signer=np.array([str(clips[i]["signer_id"]) for i in va]), gloss=np.array([glosses[i] for i in va]),
+                top1=float((z.argmax(1) == labels[va]).mean()), top1_log=float(log[int(ck["epoch"])]), epoch=int(ck["epoch"]))
+
+
+def export(threads: int = 8, only: str | None = None, logits_fn=val_logits) -> int:
+    """→ число прогонов, не прошедших сверку val_top1 с log.csv (их файл не пишется)."""
+    bad = 0
+    for c in te.C:
+        if c["kind"] != "m13" or c["ds"] == te.LO or (only and c["ds"] != only):
+            continue
+        od = te.cell_dir(c)
+        mf = od / "val_export.json"
+        meta = json.loads(mf.read_text()) if mf.is_file() else {}
+        for d in te.src_dirs(c):
+            # отбор каталога — как export_cell (тот же прогон, что у теста ячейки); probs.npz — только наличие, не читается
+            if not ((d / "probs.npz").is_file() and (d / "metrics.json").is_file() and (d / "best.pt").is_file()):
+                continue
+            fold, seed = d.parent.name, d.name.removeprefix("seed")
+            out = od / f"{fold}__val__seed{seed}.npz"
+            if out.is_file():
+                continue
+            r = logits_fn(d, threads)
+            n = len(r["ids"])
+            # допуск — как сверка m10_cache: ГП bf16 при обучении против ЦП float32 здесь
+            if abs(r["top1"] - r["top1_log"]) * n > max(2, 0.005 * n):
+                print(f"!!! сверка валидации не пройдена: {d} (эпоха {r['epoch']}) val_top1 {r['top1']:.4f} ≠ log.csv "
+                      f"{r['top1_log']:.4f}", flush=True)
+                bad += 1
+                continue
+            te.save(out, ids=r["ids"], probs=te.softmax16(r["logits"]), classes=np.array(r["names"]), signer=r["signer"],
+                    gloss=r["gloss"], role=np.full(n, "val"), run=str(d))
+            meta[out.name] = dict(run=str(d.relative_to(te.ROOT.parent)), best_pt_sha256=te.sha(d / "best.pt"), epoch=r["epoch"],
+                                  n_val=n, val_top1=r["top1"], val_top1_log=r["top1_log"])
+            mf.write_text(json.dumps(meta, ensure_ascii=False, indent=1))
+            print("готово (валидация)", out.relative_to(te.OUT), "val_top1", round(r["top1"], 4), flush=True)
+    return bad
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--threads", type=int, default=8)
+    ap.add_argument("--dataset", choices=["Slovo", "Bukva"])
+    a = ap.parse_args()
+    sys.exit(1 if export(a.threads, a.dataset) else 0)
