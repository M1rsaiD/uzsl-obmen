+
+    def f(d, threads):
+        va = split[d.parent.name]["val"]
+        gloss = np.array([clips[i]["gloss"] for i in va])
+        lg = logits(gloss, skill["UzSohn" if "uzsohn_e1" in str(d) else "Sohn"], np.random.default_rng(int(d.name[4:])))
+        t = float((CLS[lg.argmax(1)] == gloss).mean())
