+# ---------------------------------------------------------------- страж записи (до импорта раннера и до plan())
+def _deny(*ps) -> None:
+    for p in ps:
+        try:
+            r = os.path.realpath(os.fspath(p))
+        except TypeError:  # None, дескриптор файла
+            continue
+        if any(r == q or r.startswith(q + os.sep) for q in PROT):
+            raise PermissionError("T7: запись под runs/ запрещена (страж)")  # путь не печатается: в нём бывает имя фолда
