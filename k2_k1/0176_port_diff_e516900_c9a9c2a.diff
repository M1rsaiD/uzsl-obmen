+# ---------------------------------------------------------------- по рецензиям T7: то, чего след T7 не видит (заглушки, ЦП)
+def _capture(ts, monkeypatch) -> dict:
+    """Обучающие forward (logits, emb_logits, part_logits по головам), метки пакетов, потеря и свежий градиент к backward,
+    grad к opt.step."""
+    import torch
+    rec, box = {"fwd": [], "y": [], "loss": [], "fresh": [], "grad": []}, {}
+    fwd, coll, bwd = ts.SohnShared.forward, ts.collate, torch.Tensor.backward
+    step, init = torch.optim.AdamW.step, torch.optim.AdamW.__init__
+
+    def fwd_w(self, *a):
+        r = fwd(self, *a)
+        if self.training:
+            rec["fwd"].append([(o["logits"].detach().clone(), o["emb_logits"].detach().clone(), o["part_logits"])
+                               for o in (r if isinstance(r, list) else [r])])
+        return r
+
+    def coll_w(items):
+        x, m, y = coll(items)
+        rec["y"].append(y.clone())
+        return x, m, y
+
+    def bwd_w(self, *a, **k):
+        ps = [p for g in box["opt"].param_groups for p in g["params"]]
+        rec["loss"].append(self.item())
+        rec["fresh"].append(torch.autograd.grad(self, ps, retain_graph=True, allow_unused=True))
+        return bwd(self, *a, **k)
+
+    def step_w(self, *a, **k):
+        rec["grad"].append([None if p.grad is None else p.grad.clone() for g in self.param_groups for p in g["params"]])
+        return step(self, *a, **k)
+    step_w.hooked = True  # torch не оборачивает повторно (Optimizer._patch_step_function)
+
+    def init_w(self, *a, **k):
+        init(self, *a, **k)
+        box["opt"] = self
+
+    for o, n, v in ((ts.SohnShared, "forward", fwd_w), (ts, "collate", coll_w), (torch.Tensor, "backward", bwd_w),
+                    (torch.optim.AdamW, "step", step_w), (torch.optim.AdamW, "__init__", init_w)):
+        monkeypatch.setattr(o, n, v)
+    return rec
+
