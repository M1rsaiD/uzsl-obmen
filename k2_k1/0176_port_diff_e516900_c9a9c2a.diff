+def split_sizes(cfg: dict) -> dict:
+    """Записей train и val фолда каждого набора (путь — как у порта: от корня дерева)."""
+    out = {}
+    for name, dc in sets_of(cfg).items():
+        p = Path(dc["split"]) if Path(dc["split"]).is_absolute() else ROOT / dc["split"]
+        f = json.loads(p.read_text())["folds"][dc["fold"]]
