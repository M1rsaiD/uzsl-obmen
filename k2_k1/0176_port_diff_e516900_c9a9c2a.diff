+    """Потеря шагов 1 и 2 = Σ_k n_k/bs · [CE_ls(logits_k, y_k) + λ·CE_ls(emb_k, y_k)] (один набор — без веса; part_logits у _Base
+    пусты) — как mpk.train.run, по перехваченным выходам forward по головам, меткам пакета и потере (на ЦП след T7 потерь не
+    сравнивает: mpk.train — под bf16); grad к opt.step шага 2 = градиенту потери шага 2 (zero_grad: без накопления с шага 1)."""
+    import torch
+    import torch.nn.functional as F
+    ts, d, ids = port
+    rec = _capture(ts, monkeypatch)
+    cfg = _sb_cfg(d, ids) if multi else _bukva_cfg(d, ids)
+    m = ts.run(cfg, 0, d / "o", 2, 0, d / "g3_code.txt")
+    lam, ls, bs, share = cfg["loss"]["lambda_emb"], cfg["loss"]["label_smoothing"], cfg["train"]["batch_size"], list(m["batch_share"].values())
+    ce = lambda lg, y: F.cross_entropy(lg.float(), y, label_smoothing=ls).item()
+    assert lam > 0 and ls > 0 and len(rec["fwd"]) == len(rec["loss"]) == len(rec["grad"]) == 2 and (len(share) == 2) == multi
+    for heads, y, loss in zip(rec["fwd"], rec["y"], rec["loss"]):  # первые пакеты — обучение (оценка — после шага 2)
+        ys, w = (y.split(share), [n / bs for n in share]) if multi else ([y], [1.0])
+        assert len(heads) == len(ys) and not any(p for *_, p in heads)
+        exp = sum(wk * (ce(lg, yy) + lam * ce(e, yy)) for (lg, e, _), yy, wk in zip(heads, ys, w))
+        assert abs(loss - exp) <= 1e-5 * abs(exp), (loss, exp)
+    for g, f in zip(rec["grad"][1], rec["fresh"][1]):
+        assert (g is None) == (f is None) and (g is None or torch.allclose(g, f, rtol=1e-6, atol=1e-9))
