+# ---------------------------------------------------------------- запись следа (одна сторона)
+class Rec:
+    def __init__(self, side: str):
+        self.side, self.steps, self.ev, self.evals, self.saves = side, [], [], [], []
+        self.ema_args, self.ema_n, self.merge, self.init, self.payload, self.cur, self.logs = [], [], {}, None, None, {}, []
+
+    def on_opt(self, opt) -> None:
+        """Шаг = вызов AdamW.step: (lr групп, замороженные, группы с частью grad None, BN в выводе _BatchNorm / MaskedBN,
+        состав пакета, записей вне train, прочие гиперпараметры групп, параметры группы 0 (головы) с grad None)."""
+        pg = opt.param_groups
+        none = [[p.grad is None for p in g["params"]] for g in pg[1:]]
+        c = self.cur
+        self.steps.append((tuple(g["lr"] for g in pg), tuple(k for k, n in enumerate(none) if all(n)),
+                           tuple(k for k, n in enumerate(none) if any(n) and not all(n)), c.get("bn_t"), c.get("bn_m"),
+                           c.get("comp"), c.get("out"), tuple(tuple(sorted((k, v) for k, v in g.items() if k not in ("params", "lr")))
+                                                              for g in pg), tuple(i for i, p in enumerate(pg[0]["params"]) if p.grad is None)))
+        self.ev.append("opt")
+        self.cur = {}
+
+    def on_part(self, k: int, n: int, outside: int) -> None:  # кусок пакета одного набора
+        self.cur["comp"] = self.cur.get("comp", ()) + ((k, n),)
+        self.cur["out"] = self.cur.get("out", 0) + outside
+
+    def on_eval(self, k: int) -> None:
+        self.ev.append("eval")
+        self.evals.append((len(self.steps), k))
+
+
+R: Rec = None  # текущая сторона
+SIZES: dict = {}
+POOL: tuple = ()
+
+
+class Done(Exception):
+    """torch.load(best.pt) сразу после петли mpk.train — конец наблюдаемой части."""
+
+
+def acc_at(step: int, k: int = 0) -> float:
+    """Заданная точность оценки по шагу и голове k (одна у обеих сторон; у голов S+B разная — иначе отбор по одной голове
+    неотличим от отбора по среднему): рост + псевдослучайность; шаг 0,05 — сравнение v1 > best не зависит от float32
+    (mpk.train) / float64 (порт) при val ≥ 40 записей."""
+    u = np.random.default_rng([step, 7, k]).random()  # псевдослучайно по шагу и голове
+    return round(20 * min(0.95, 0.1 * math.log1p(step / 25) + 0.3 * u)) / 20
+
+
+def _logits(y, step: int, k: int):
+    import torch
+    c = round(acc_at(step, k) * len(y))
+    return torch.nn.functional.one_hot(torch.where(torch.arange(len(y)) < c, y, (y + 1) % NC), NC).float()
+
+
+def _idx(name: str, merge: bool) -> tuple[dict, np.ndarray]:
+    n_tr, n_va = SIZES[name]
+    assert merge or n_va >= 40, (name, n_va)
+    idx = {"train": np.arange(n_tr), "val": np.arange(n_tr, n_tr + n_va), "test": np.empty(0, np.int64)}
+    if merge:  # train ∪ val, val нет — как у настоящих load_set / prepare_set
+        idx["train"], idx["val"] = np.arange(n_tr + n_va), np.empty(0, np.int64)
+    return idx, np.arange(n_tr + n_va) % NC
+
+
+def _stubs():
+    """Классы-заглушки (torch — внутри: модуль импортирует и раннер-часть без torch)."""
+    import torch
+    from mpk import sohn
+    from mpk.baselines import _Base
+
+    class Block(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.lin, self.bn, self.mbn = torch.nn.Linear(D, D), torch.nn.BatchNorm1d(D), sohn.MaskedBN(D)
+
+    class TinyNet(torch.nn.Module):
+        """5 групп (0 — верх, 4 — вход); set_pass / commit_bn — как у SohnNet (по всем MaskedBN), наблюдаются."""
+
+        def __init__(self):
+            super().__init__()
+            self.g = torch.nn.ModuleList([Block() for _ in range(5)])
+
+        def forward(self, x, m):
+            R.ev.append("fwd")
+            R.cur.update(bn_t=tuple(k for k, b in enumerate(self.g) if not b.bn.training),
+                         bn_m=tuple(k for k, b in enumerate(self.g) if not b.mbn.training))
+            h = x.float().mean(1)
+            for b in reversed(self.g):  # снизу вверх; каждая группа — в потере (иначе grad None подделал бы заморозку)
+                h = b.mbn(b.bn(b.lin(h).float())[:, None], m[:, :1])[:, 0]
+            if R.side == "mpk":  # mpk.train commit_bn не зовёт — накопленные моменты MaskedBN не копятся
+                for b in self.g:
+                    b.mbn.acc = {}
+            return h
+
+        def set_pass(self, k):
+            R.ev.append("set_pass")
+            for b in self.g:
+                b.mbn.pass_id = k
+
+        def commit_bn(self):
+            R.ev.append("commit")
+            for b in self.g:
+                b.mbn.commit()
+
+    class Tiny(_Base):
+        def __init__(self, mc, n_classes):
+            super().__init__(D, {"input": "mpk", "eps": 1e-3, "clip": 10.0, "in_channels": [0], "emb_dim": 4, "emb_scale": 16.0},
+                             n_classes)
+            self.net = TinyNet()
+
+        def encode(self, x, mask, aspect=None):
+            return (self.net(x, mask),)
+
+        def layer_groups(self):
+            return [[b] for b in self.net.g]
+
+    class FakeDL:
+        """DataLoader порта: пакеты — его настоящий batch_sampler (Batches), тензоры — крошечные."""
+
+        def __init__(self, dataset, batch_sampler=None, **kw):
+            assert batch_sampler is not None
+            self.S, self.bsm = dataset.S, batch_sampler
+
+        def __iter__(self):
+            tr = [set(s["idx"]["train"].tolist()) for s in self.S]
+            for b in self.bsm:
+                comp = []  # куски наборов подряд: ((набор, записей), …)
+                for k, _, _ in b:
+                    if comp and comp[-1][0] == k:
+                        comp[-1][1] += 1
+                    else:
+                        comp.append([k, 1])
+                R.cur.update(comp=tuple(map(tuple, comp)), out=sum(i not in tr[k] for k, i, _ in b))
+                yield POOL[0][:len(b)], POOL[1][:len(b)], torch.tensor([int(self.S[k]["y"][i]) for k, i, _ in b])
+
+    return Tiny, FakeDL
+
