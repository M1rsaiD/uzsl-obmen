+def _arg(a, k, i):
+    return a[i] if len(a) > i else next((k[n] for n in (("path", "name", "file", "src"), ("dst", "target"))[min(i, 1)] if n in k), None)
+
+
+def guard() -> None:
+    """open/io.open/os.open на запись, Path.write_*/mkdir/touch/rename/…, os.makedirs/mkdir/rename/…, shutil.copy*/move/rmtree,
+    torch.save (пишет из C++ мимо open); аудит-хук «open» на запись — ещё io.FileIO и открытия из C-расширений через Python."""
+    import torch
+    W = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_APPEND | os.O_TRUNC
+    wr = lambda a, k: any(c in (a[1] if len(a) > 1 else k.get("mode", "r")) for c in "wax+") and _deny(_arg(a, k, 0))
+    one, two = (lambda a, k: _deny(_arg(a, k, 0))), (lambda a, k: _deny(_arg(a, k, 0), _arg(a, k, 1)))
+    rules = [(builtins, "open", wr), (io, "open", wr),
+             (os, "open", lambda a, k: (a[1] if len(a) > 1 else k.get("flags", 0)) & W and _deny(_arg(a, k, 0))),
+             *[(Path, n, one) for n in ("write_text", "write_bytes", "mkdir", "touch", "unlink", "rmdir")],
+             *[(Path, n, two) for n in ("rename", "replace", "symlink_to", "hardlink_to")],
+             *[(os, n, one) for n in ("makedirs", "mkdir", "remove", "unlink", "rmdir")], (os, "rename", two), (os, "replace", two),
+             *[(shutil, n, lambda a, k: _deny(_arg(a, k, 1))) for n in ("copy", "copy2", "copyfile", "copytree")],
+             (shutil, "move", two), (shutil, "rmtree", one), (torch, "save", lambda a, k: _deny(a[1] if len(a) > 1 else k.get("f")))]
+    for owner, name, chk in rules:
+        f = getattr(owner, name)
+        if getattr(f, "t7_guard", False):
+            continue
+
+        def g(*a, _f=f, _c=chk, **k):
+            _c(a, k)
+            return _f(*a, **k)
+        g.t7_guard = True
+        setattr(owner, name, g)
+    sys.addaudithook(lambda ev, a: ev == "open" and isinstance(a[0], (str, os.PathLike))
+                     and bool((a[2] or 0) & W or any(c in (a[1] or "") for c in "wax+")) and _deny(a[0]))
+
+
+def guard_selftest() -> None:
+    """Страж на временном каталоге, объявленном защищённым (под настоящий runs/ проба не пишет)."""
+    import torch
+    with tempfile.TemporaryDirectory() as d:
+        PROT.append(os.path.realpath(d))
+        try:
+            for f in (lambda: open(Path(d) / "a", "w"), lambda: (Path(d) / "b").write_text("x"), lambda: os.makedirs(Path(d) / "c"),
+                      lambda: (Path(d) / "e").touch(), lambda: shutil.copy(__file__, d), lambda: io.FileIO(Path(d) / "i", "w"),
+                      lambda: os.open(Path(d) / "k", os.O_WRONLY | os.O_CREAT), lambda: torch.save({}, Path(d) / "j.pt")):
+                with contextlib.suppress(PermissionError):
+                    f()
+                    raise AssertionError("страж записи не сработал")
+            assert not os.listdir(d), "страж пропустил запись"
+        finally:
+            PROT.pop()
+
