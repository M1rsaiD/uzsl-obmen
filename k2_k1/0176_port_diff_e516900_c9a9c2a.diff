+# ---------------------------------------------------------------- задания группы 3 (как строит раннер)
+def sets_of(cfg: dict) -> dict:
+    return cfg["data"]["sets"] if "sets" in cfg["data"] else {cfg["data"]["dataset"]: cfg["data"]}
+
+
+def select(types) -> list[dict]:
+    """plan((3,)) на настоящих шаблонах → по заданию на тип; метка без имени фолда."""
+    import turnir_eval as te
+    import turnir_train as tt
+    te.RUNS, tt.RUNS, tt.TR = RUNS, RUNS, RUNS / "TURNIR/train"
+    J = tt.plan((3,))
+    miss = [j for j in J if j.get("missing")]
+    assert not miss, f"группа 3: {len(miss)} заданий без шаблона"
+    by = {}
+    for j in J:
+        if j["cell"] == "pretrain/Sohn_shared":
+            t, n, lab = "sb", 0, "S+B/pretrain"
+        else:
+            ds, _, _, cond = j["cell"].split("/")
+            t = {"Slovo": "slovo", "Bukva": "bukva"}.get(ds) or f"uzsl_{cond}"
+            n = te.FOLDS[ds].index(j["cfg"]["data"]["fold"]) + 1
+            lab = f"{ds}/{cond}/фолд#{n}"
+        by.setdefault(t, []).append((j["cfg"]["train"]["steps"], n, lab, j))
+    sel = []
+    for t in types:
+        assert by.get(t), f"тип {t}: в плане группы 3 нет заданий (все затравки готовы?)"
+        # при равных шагах — меньший фолд#, затем наименьшая затравка плана (до старта группы 3 — 0)
+        lo = min(by[t], key=lambda x: (x[0], x[1], x[3]["seed"]))
+        hi = min(by[t], key=lambda x: (-x[0], x[1], x[3]["seed"]))
+        for st, n, lab, j in {id(x): x for x in ([lo, hi] if t == "uzsl_transfer" else [hi])}.values():
+            sel.append({"type": t, "label": f"{lab}/з{j['seed']}", "cfg": j["cfg"], "seed": j["seed"]})
+    return sel
