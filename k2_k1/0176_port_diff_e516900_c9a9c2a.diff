+def pair(cfg: dict, seed: int, sizes: dict, tmp: Path) -> tuple[Rec, Rec, list | None, list[str]]:
+    """Порт и mpk.train на одном конфиге (через их main, как раннер) под одними заглушками и перехватом."""
+    import torch
+    import mpk.augment as maug
+    import mpk.train as mtr
+    import turnir_sohn_shared as ts
+    from torch.optim.lr_scheduler import LambdaLR
+    from torch.optim.swa_utils import AveragedModel
+    global R, SIZES, POOL
+    Tiny, FakeDL = _stubs()
+    SIZES, bs = sizes, cfg["train"]["batch_size"]
+    POOL = (torch.randn(bs, 2, D, generator=torch.Generator().manual_seed(0)), torch.ones(bs, 2, dtype=torch.bool), torch.ones(bs))
+    (tmp / "port.yaml").write_text(yaml.safe_dump(cfg, allow_unicode=True, sort_keys=False))  # как run_job раннера
+    cm = copy.deepcopy(cfg)
+    cm["device"], cm["train"]["compile"] = "cpu", False
+    (tmp / "mpk.yaml").write_text(yaml.safe_dump(cm, allow_unicode=True, sort_keys=False))
+    o_step, o_sched, o_upd = torch.optim.AdamW.step, LambdaLR.step, AveragedModel.update_parameters
+
+    def w_step(self, *a, **k):
+        R.on_opt(self)
+        return o_step(self, *a, **k)
+    w_step.hooked = True  # torch не оборачивает повторно (Optimizer._patch_step_function)
+
+    def w_sched(self, *a, **k):
+        R.ev.append("sched")
+        return o_sched(self, *a, **k)
+
+    def w_upd(self, model):
+        R.ev.append("ema")
+        return o_upd(self, model)
+
+    def w_save(obj, f, *a, **k):
+        R.ev.append("save")
+        R.saves.append((len(R.steps), obj["step"]))
+        R.payload = obj
+
+    def w_load(f, *a, **k):
+        if R.side == "port" and R.payload is not None:
+            return R.payload  # порт идёт до конца и возвращает свой trace
+        raise Done
+
+    def ema_wrap(orig):
+        def w(decay, warmup):
+            R.ema_args.append((decay, warmup))
+            fn = orig(decay, warmup)
+
+            def f(e, c, n):
+                R.ema_n.append((len(R.steps), int(n)))
+                return fn(e, c, n)
+            return f
+        return w
+
+    o_writer = csv.writer
+
+    def w_writer(f, *a, **k):  # строка журнала = блок оценки (step % eval_every == 0 или последний), есть и без val
+        w = o_writer(f, *a, **k)
+
+        def row(r):
+            if isinstance(r[0], int):  # не заголовок
+                R.logs.append((len(R.steps), r[0], r[1]))
+            return w.writerow(r)
+        return SimpleNamespace(writerow=row)
+
+    def init(model, path):
+        R.init = path
+        return {"stub": "load_init"}
+
+    def p_load_set(name, dc, merge_val):
+        R.merge[name] = merge_val
+        idx, y = _idx(name, merge_val)
+        return {"name": name, "recs": None, "clips": None, "idx": idx, "labels": [f"c{i}" for i in range(NC)], "y": y,
+                "asp": None, "inputs": []}
+
+    def p_infer(model, S, k, idx, T, dev, workers):
+        R.on_eval(k)
+        return _logits(torch.as_tensor(S[k]["y"][idx]), len(R.steps), k).numpy()
+
+    names = list(sets_of(cfg))
+
+    def m_prepare_set(name, dc, cfg_, dev, refit):
+        R.merge[name] = refit
+        idx, y = _idx(name, refit)
+        yt = torch.as_tensor(y)
+        ds = SimpleNamespace(samslr=None, k=names.index(name), y=yt, train=set(idx["train"].tolist()))
+        return {"name": name, "cache": None, "idx": idx, "labels": [f"c{i}" for i in range(NC)], "signer": None, "aug": None,
+                "y": yt, "ds": ds, "tidx": {r: torch.as_tensor(v) for r, v in idx.items()}, "counts": {}, "dominant_signers": None}
+
+    def m_batch(ds, clips, T, aug, g):
+        n = len(clips)
+        R.on_part(ds.k, n, sum(i not in ds.train for i in clips.tolist()))
+        return POOL[0][:n], POOL[1][:n], POOL[2][:n]
+
+    def m_infer(model, ds, clips, T, bs_, name):
+        R.on_eval(ds.k)
+        y = ds.y[clips]
+        return _logits(y, len(R.steps), ds.k), torch.zeros(len(y), 4)
+
+    common = [(torch.optim.AdamW, "step", w_step), (LambdaLR, "step", w_sched), (AveragedModel, "update_parameters", w_upd),
+              (torch, "save", w_save), (torch, "load", w_load), (torch.cuda, "is_available", lambda: False), (csv, "writer", w_writer)]
+    sides = {"port": ([(ts, "SohnShared", Tiny), (ts, "load_set", p_load_set), (ts, "DataLoader", FakeDL), (ts, "infer", p_infer),
+                       (ts, "load_init", init), (ts, "ema_avg_fn", ema_wrap(ts.ema_avg_fn))],
+                      lambda: ts.main(["--config", str(tmp / "port.yaml"), "--seed", str(seed), "--out", str(tmp / "port"),
+                                       "--workers", "0", "--code-file", str(tmp / "g3_code.txt")])),
+             "mpk": ([(mtr, "build_model", Tiny), (mtr, "prepare_set", m_prepare_set), (mtr, "infer", m_infer), (mtr, "load_init", init),
+                      (mtr, "code_state", lambda: {}), (maug, "batch", m_batch), (mtr, "ema_avg_fn", ema_wrap(mtr.ema_avg_fn))],
+                     lambda: mtr.main(["--config", str(tmp / "mpk.yaml"), "--seed", str(seed), "--out", str(tmp / "mpk")]))}
+    recs, trace, err = {}, None, []
+    det = torch.are_deterministic_algorithms_enabled(), torch.is_deterministic_algorithms_warn_only_enabled()
+    for side, (pats, call) in sides.items():
+        R = recs[side] = Rec(side)
+        with contextlib.ExitStack() as st:
+            for o, n, v in common + pats:
+                st.enter_context(mock.patch.object(o, n, v))
+            try:
+                res = call()
+                if side == "port":
+                    trace = res["trace"]
+                else:
+                    err.append("mpk.train: прогон не дошёл до torch.load(best.pt)")
+            except Done:
+                if side == "port":
+                    err.append("порт: torch.load(best.pt) без сохранения")
+            except Exception as e:  # noqa: BLE001 — в отчёт тип и начало сообщения (имена фолдов скрыты)
+                err.append(f"{side}: {type(e).__name__}: {mask(str(e))[:300]}")
+            finally:
+                torch.use_deterministic_algorithms(det[0], warn_only=det[1])
+    return recs["port"], recs["mpk"], trace, err
+
+
+def mask(s: str) -> str:
+    import turnir_eval as te
+    for names in te.FOLDS.values():
+        for n in names:
+            s = s.replace(n, "<фолд>")
+    return s
+
+
+# ---------------------------------------------------------------- сравнение по каждому шагу
+def _diff(a, b) -> str:
+    if not isinstance(a, list):
+        return f"{a} ≠ {b}"
+    i = next((i for i, (x, y) in enumerate(zip(a, b)) if x != y), min(len(a), len(b)))
+    return f"длины {len(a)}/{len(b)}, первое отличие №{i}: {a[i] if i < len(a) else '—'} ≠ {b[i] if i < len(b) else '—'}"
+
+
+def compare(P: Rec, M: Rec, trace, steps: int) -> tuple[list[str], int]:
+    """Порт против mpk.train → (первые 50 расхождений текстом, число всех)."""
+    bad, n_bad = [], [0]
+
+    def add(ok, msg):
+        if not ok:
+            n_bad[0] += 1
+            if len(bad) < 50:
+                bad.append(msg() if callable(msg) else msg)
+
+    eq = lambda a, b: len(a) == len(b) and all(x == y or abs(x - y) <= 1e-12 * max(abs(x), abs(y)) for x, y in zip(a, b))
+    add(len(M.steps) == steps, f"mpk.train: шагов {len(M.steps)} ≠ train.steps {steps}")
+    add(len(P.steps) == len(M.steps), f"шагов: порт {len(P.steps)} ≠ mpk.train {len(M.steps)}")
+    for i, (p, m) in enumerate(zip(P.steps, M.steps), 1):
+        add(eq(p[0], m[0]), lambda: f"шаг {i}: lr групп порт {p[0]} ≠ mpk.train {m[0]}")
+        add(p[1] == m[1], lambda: f"шаг {i}: замороженные группы порт {p[1]} ≠ mpk.train {m[1]}")
+        add(p[4] == m[3] == m[1], lambda: f"шаг {i}: BN в режиме вывода — MaskedBN порта {p[4]}, _BatchNorm mpk.train {m[3]}, "
+                                          f"замороженные mpk.train {m[1]}")
+        add(p[5] == m[5], lambda: f"шаг {i}: состав пакета порт {p[5]} ≠ mpk.train {m[5]}")
+        add(p[7] == m[7], lambda: f"шаг {i}: гиперпараметры групп AdamW (кроме lr): порт ≠ mpk.train — {_diff(list(p[7]), list(m[7]))}")
+        add(p[8] == m[8], lambda: f"шаг {i}: параметры голов (группа 0) с grad None порт {p[8]} ≠ mpk.train {m[8]}")
+        add(not p[2] and not m[2] and p[6] == m[6] == 0, lambda: f"шаг {i}: группы с частью grad None {p[2]}/{m[2]}, "
+                                                                 f"записей вне train {p[6]}/{m[6]}")
+    for what, a, b in (("шаги оценки (шаг, набор)", P.evals, M.evals), ("сохранения (шаг, step в best.pt)", P.saves, M.saves),
+                       ("ema_avg_fn (decay, прогрев)", P.ema_args, M.ema_args), ("усреднения EMA (шаг, n)", P.ema_n, M.ema_n),
+                       ("train ∪ val по наборам", P.merge, M.merge), ("init_from", P.init, M.init),
+                       ("блоки оценки — строки журнала (шаг, step, lr)", P.logs, M.logs)):
+        add(a == b, lambda: f"{what}: порт ≠ mpk.train — {_diff(a, b)}")
+    ev = [e for e in P.ev if e not in ("set_pass", "commit")]
+    add(ev == M.ev, lambda: f"порядок событий (без set_pass/commit_bn): {_diff(ev, M.ev)}")
+    n = len(P.steps)
+    add(P.ev.count("set_pass") == P.ev.count("commit") == n, f"порт: set_pass {P.ev.count('set_pass')}, commit_bn "
+                                                             f"{P.ev.count('commit')} при {n} шагах")
+    off = [i for i, e in enumerate(P.ev) if e == "commit" and P.ev[i - 1:i + 2] != ["sched", "commit", "ema"]
+           or e == "set_pass" and P.ev[i:i + 2] != ["set_pass", "fwd"]]
+    add(not off, lambda: f"порт: порядок set_pass → forward, opt.step → sched.step → commit_bn → EMA нарушен (событие №{off[0]})")
+    if trace is None:
+        add(False, "порт не вернул trace")
+    else:
+        tr, mine = [(s, tuple(lr), tuple(f)) for s, lr, f in trace], [(i, p[0], p[1]) for i, p in enumerate(P.steps, 1)]
+        add(tr == mine, lambda: f"trace порта ≠ перехваченному следу порта: {_diff(tr, mine)}")
+    return bad, n_bad[0]
+
+
+def check_job(cfg: dict, seed: int, sizes: dict) -> dict:
+    """Задание T7: обе петли + сравнение → {bad: первые расхождения, n_bad, шаги, групп, оценок, сохранения, EMA, время}."""
+    t0 = time.time()
+    with tempfile.TemporaryDirectory(prefix="t7_") as d:
+        P, M, trace, err = pair(cfg, seed, sizes, Path(d))
+    bad, n = compare(P, M, trace, cfg["train"]["steps"])
+    return {"bad": err + bad, "n_bad": len(err) + n, "steps": len(M.steps), "n_groups": len(M.steps[0][0]) - 1 if M.steps else 0,
+            "evals": len(M.logs), "infer": len({s for s, _ in M.evals}), "saves": [s for _, s in M.saves], "ema": M.ema_args,
+            "wall_s": round(time.time() - t0, 1)}
+
+
+def main(argv=None) -> int:
+    os.environ["CUDA_VISIBLE_DEVICES"] = ""  # только ЦП: ГП занята турниром (до первого обращения torch к CUDA)
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--out", required=True, help="файл полного вывода (прежний — в .bak_<время>)")
+    ap.add_argument("--only", action="append", choices=TYPES, help="только этот тип (можно несколько раз)")
+    a = ap.parse_args(argv)
+    guard()
+    guard_selftest()
+    out, lines, n_bad = Path(a.out), [], 0
+    if out.exists():
+        out.rename(out.with_name(f"{out.name}.bak_{time.strftime('%Y%m%d_%H%M%S')}"))
+
+    def say(s=""):
+        print(s, flush=True)
+        lines.append(s)
+        out.write_text("\n".join(lines) + "\n")
+
+    sel = select(a.only or TYPES)
+    import torch
+    torch.set_num_threads(1)
+    head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
+    say(f"T7 группы 3: порт против mpk.train по каждому шагу; дерево {ROOT.name} ({head}), "
+        f"{time.strftime('%Y-%m-%d %H:%M')}; ЦП, torch {torch.__version__}")
+    say("страж записи под runs/ (osnovnaya_model, uzsign_ai_v2, это дерево) — стоит, проверен на временном каталоге")
+    say("mpk.train: тот же конфиг, изменены только device: cpu и train.compile: false — на расписание не влияют")
+    say(f"{'задание':<25} {'steps':>6} {'eval':>5} {'merge':>5} {'select':>8} {'ema':>4} {'decay':>6} {'short':>5} {'below':>5} "
+        f"{'warm':>5} {'freeze':>6} {'unfr':>5} {'mult':>4} {'wfrac':>5} {'bs':>4} {'lr':>7} {'λ_emb':>5}  train/val (val в train при merge)")
+    for j in sel:
+        tc, ft, sz = j["cfg"]["train"], j["cfg"]["finetune"], split_sizes(j["cfg"])
+        j["sizes"] = sz
+        say(f"{j['label']:<25} {tc['steps']:>6} {tc['eval_every']:>5} {str(tc['merge_val']):>5} {tc['select']:>8} {str(tc['ema']):>4} "
+            f"{tc['ema_decay']:>6} {tc['ema_decay_short']:>5} {tc['ema_short_below']:>5} {str(tc['ema_warmup']):>5} "
+            f"{ft['freeze_steps']:>6} {ft['unfreeze_every']:>5} {ft['backbone_lr_mult']:>4} {tc['warmup_frac']:>5} "
+            f"{tc['batch_size']:>4} {tc['lr']:>7} {j['cfg']['loss']['lambda_emb']:>5}  "
+            + ", ".join(f"{n}: {t}/{v}" for n, (t, v) in sz.items()))
+        cm = copy.deepcopy(j["cfg"])
+        cm["device"], cm["train"]["compile"] = "cpu", False
+        assert {k for k in cm if cm[k] != j["cfg"][k]} <= {"device", "train"} and \
+            {k for k in cm["train"] if cm["train"][k] != tc[k]} <= {"compile"}
+    say()
+    for j in sel:
+        r = check_job(j["cfg"], j["seed"], j["sizes"])
+        n_bad += r["n_bad"]
+        sv = r["saves"]
+        say(f"{j['label']:<25} шагов {r['steps']:>6} | групп {r['n_groups']} | оценок {r['evals']:>3} (с val {r['infer']:>3}) | сохранений {len(sv)} "
+            f"(шаги {sv[:6]}{' …' if len(sv) > 6 else ''}) | decay/прогрев {r['ema']} | {r['wall_s']:>6.1f} с | "
+            + ("расхождений 0" if not r["n_bad"] else f"РАСХОЖДЕНИЙ {r['n_bad']}"))
+        for b in r["bad"][:5]:
+            say(f"    !!! {b}")
+        j["row"] = r
+    say(f"ИТОГ: заданий {len(sel)}, расхождений {n_bad}")
+    return 1 if n_bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
