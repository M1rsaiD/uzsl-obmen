+def test_run_job_hold(tmp_path, monkeypatch, capsys):
+    """22.10 п. 4 (только при (а)): run_job ждёт придержку Э2 перед weekend_gate; в силе — та же загрузка и юнит активен, иначе —
+    строка в журнал и прогон идёт; без файла — прежний путь (ни строки, ни systemctl)."""
+    import turnir_train as tt
+    stub = tmp_path / "stub"
+    stub.mkdir()
+    (stub / "systemctl").write_text(f'#!/usr/bin/env bash\necho "$*" >> {tmp_path}/sc.log\n[ -f {tmp_path}/active ]\n')
+    (stub / "systemctl").chmod(0o755)
+    monkeypatch.setenv("PATH", f"{stub}:{os.environ['PATH']}")
+    monkeypatch.setattr(tt, "HOLD", tmp_path / "TURNIR_HOLD_E2")
+    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
+    assert not tt.held() and capsys.readouterr().out == "" and not (tmp_path / "sc.log").exists()
+    tt.HOLD.write_text(f"123 {boot} turnir-e2\n")
+    assert not tt.held() and "придержка устарела" in capsys.readouterr().out  # юнит неактивен (SIGKILL цепочки)
+    (tmp_path / "active").touch()
+    assert tt.held() and capsys.readouterr().out == "" and (tmp_path / "sc.log").read_text().endswith("--user is-active --quiet turnir-e2\n")
+    for bad in ("123 другая-загрузка turnir-e2", "123", ""):  # перезагрузка; испорченный файл
+        tt.HOLD.write_text(bad)
+        assert not tt.held() and "придержка устарела" in capsys.readouterr().out, bad
+    seq, calls = iter([True, True, False]), []
+    monkeypatch.setattr(tt, "held", lambda: next(seq))
+    monkeypatch.setattr(tt.time, "sleep", calls.append)
+
+    class Gate(Exception):
+        pass
+
+    def gate(cmd, **kw):
+        calls.append(Path(cmd[1]).name)
+        raise Gate
+
+    monkeypatch.setattr(tt.subprocess, "run", gate)
+    with pytest.raises(Gate):
+        tt.run_job({"out": str(tmp_path / "cell/fold1/seed0")})
+    assert calls == [60, 60, "weekend_gate.sh"]
