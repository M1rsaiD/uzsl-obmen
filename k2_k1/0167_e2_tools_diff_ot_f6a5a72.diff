+def test_freeze_gate(tmp_path, monkeypatch, capsys):
+    """П23: маркер заморозки — полный хеш коммита в 1-й строке, предрегистрация в HEAD = в нём; иначе — отказ со строкой «!!!»."""
+    root = tmp_path / "OM"
+    (root / "reports").mkdir(parents=True)
+    _git(root, "init", "-q")
+    (root / "reports/TURNIR_prereg.md").write_text("предрег.\n", encoding="utf-8")
+    _git(root, "add", "reports/TURNIR_prereg.md")
+    _git(root, "commit", "-qm", "предрег.")
+    (root / "reports/TURNIR_prereg.md").write_text("предрег.\nпоправка «заморозка»\n", encoding="utf-8")
+    _git(root, "commit", "-qam", "заморозка")
+    h = _git(root, "rev-parse", "HEAD")
+    monkeypatch.setattr(te, "ROOT", root)
+    monkeypatch.setattr(te, "RUNS", root / "runs")
+    assert not te.frozen() and "!!! ворота заморозки" in capsys.readouterr().out
+    (root / "runs").mkdir()
+    for bad in ("", h[:12], "x" * 40, "0" * 40, h.upper()):
+        (root / "runs/TURNIR_FREEZE").write_text(bad + "\n")
+        assert not te.frozen(), bad
+    (root / "runs/TURNIR_FREEZE").write_text(h + "\nзаморозка — к2, после сверки\n")
+    assert te.frozen()
+    (root / "x.txt").write_text("x")
+    _git(root, "add", "x.txt")
+    _git(root, "commit", "-qm", "не поправка")
+    (root / "runs/TURNIR_FREEZE").write_text(_git(root, "rev-parse", "HEAD") + "\n")
+    assert not te.frozen()  # хеш коммита без правки предрег. (HEAD) — не коммит поправки (рецензия Э2: V3)
+    (root / "runs/TURNIR_FREEZE").write_text(h + "\n")
+    assert te.frozen()
+    (root / "reports/TURNIR_prereg.md").write_text("поправка «заморозка»\nпоправка после неё\n", encoding="utf-8")
+    assert not te.frozen()  # предрегистрация ≠ замороженной (незакоммиченная правка)
+    _git(root, "commit", "-qam", "после заморозки")
