+def test_e3_row_is_three_of_five(stand):
+    """П25: «Sohn×3» — среднее softmax 3 затравок по всем C(5, 3), против одиночки; Δ — независимо от correct_ens (сочетания,
+    argmax, macro по исполнителям) — рецензия Э2: мутант T01 (N = 4)."""
+    stand()
+    for c in te.C:
+        if c["model"] == "Sohn" and c["ds"] == "Slovo":
+            te.export_cell(c, 1)
+    sm = te.load_model(te.PRED / "Slovo/Sohn/native/scratch")
+    ids, signer, gloss = te.align([sm])
+    seeds, cls = sorted(sm), sm[42]["classes"]
+    P = {s: sm[s]["probs"][np.searchsorted(sm[s]["ids"], ids)].astype(np.float32) for s in seeds}
+    c3 = np.mean([cls[sum(P[s] for s in cb).argmax(1)] == gloss for cb in itertools.combinations(seeds, 3)], 0)
+    c1 = np.mean([cls[P[s].argmax(1)] == gloss for s in seeds], 0)
+    d = 100 * np.mean([c3[signer == s].mean() - c1[signer == s].mean() for s in sorted(set(signer) - {"other"})])
+    assert te.e3_row("Slovo", sm).split(" | ")[2] == f"{d:+.2f}"
