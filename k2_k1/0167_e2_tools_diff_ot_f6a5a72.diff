+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def recs(prefix, signers, rng):
+    ids = np.array([f"{prefix}{s}_{i}" for s in signers for i in range(REC)])
+    return ids, np.repeat(signers, REC), CLS[rng.integers(0, K, len(ids))]
+
+
+def logits(gloss, skill, rng):
+    lg = rng.normal(0, 1, (len(gloss), K))
+    lg[np.arange(len(gloss)), np.searchsorted(CLS, gloss)] += skill
+    return lg
+
+
+def m13_run(d, ids, signer, gloss, lg, meta):
+    """Каталог m13_train: probs.npz + predictions.csv + metrics.json."""
+    d.mkdir(parents=True)
+    np.savez(d / "probs.npz", ids=ids, probs=te.softmax16(lg), classes=CLS)
+    with open(d / "predictions.csv", "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f)
+        w.writerow(["dataset", "sample_id", "signer_id", "gloss", "pred", "correct", "top5"])
+        w.writerows([["x", i, s, g, "", "", ""] for i, s, g in zip(ids, signer, gloss)])
+    (d / "metrics.json").write_text(json.dumps(meta or {}))
+
+
+def mpk_run(d, cache, exp, cond, fold, seed, parts):
+    """Прогон mpk.train: best.pt + metrics.json; вероятности — кэш M10 (как m10_cache)."""
+    d.mkdir(parents=True)
+    (d / "best.pt").write_bytes(b"")
+    (d / "metrics.json").write_text(json.dumps({"config": {"data": {"fold": fold}, "seed": seed, "experiment": exp, "condition": cond}}))
+    ids, signer, gloss, role, lg = (np.concatenate(x) for x in zip(*parts))
+    p = cache / exp / cond / f"{fold}_seed{seed}.npz"
+    p.parent.mkdir(parents=True, exist_ok=True)
+    np.savez(p, sample_id=ids, logits=lg, labels=CLS, signer=signer, gloss=gloss, role=role, top1_test=0.5)
+
+
+def build(base: Path, rng, uz=None) -> None:
+    """Синтетический турнир: Slovo (5 фолдов; валидация — S01 / S03) и корпус (LOSO S01…S10 + other); A1 и SL-GCN — прогоны
+    mpk.train, Sohn (и UzSohn в Э1 при uz) — каталоги M13; разбиения и опись кэша M13 — для печати 22.7."""
+    runs, v2 = base / "OM/runs", base / "uzsign_ai_v2/runs"
+    cache = runs / "M10/cache"
+    sk = {"A1": 1.5, "SL-GCN": 1.8, "Sohn": 1.6, "UzSohn": 2.0}
+    clips = {"slovo": [], "bukva": []}
+    split = {"slovo": {"folds": {}}, "bukva": {"folds": {"fold1": {"train": [], "val": [], "test": []}}}}
+    for k, fold in enumerate(FOLDS_P):
+        t, v = recs(f"t{k}", SIG[2 * k: 2 * k + 2], rng), recs(f"v{k}", ["S03" if k == 0 else "S01"], rng)
+        clips["slovo"] += [dict(sample_id=i, signer_id=s, gloss=g) for x in (t, v) for i, s, g in zip(*x)]
+        split["slovo"]["folds"][fold] = {"train": [], "val": list(v[0]), "test": list(t[0])}
+        for model, path in (("A1", "M7/slovo_a_ema"), ("SL-GCN", "M11G2/g2_slovo_slgcn_orig_mpkrec")):
+            for s in range(3):
+                mpk_run(runs / path / fold / f"seed{s}", cache, *path.split("/"), fold, s,
+                        [(*x, np.full(len(x[0]), r), logits(x[2], sk[model], rng)) for x, r in ((t, "test"), (v, "val"))])
+        for model, tag in (("Sohn", "slovo"),) + ((("UzSohn", "uzsohn_e1_slovo"),) if uz else ()):
+            for s in range(42, 47):
+                m13_run(runs / "UzSohn" / tag / fold / f"seed{s}", *t, logits(t[2], sk[model], rng), uz if model == "UzSohn" else None)
+    b = recs("b", ["S05", "S11", "S12", "S07"], rng)
+    clips["bukva"] = [dict(sample_id=i, signer_id=s, gloss=g) for i, s, g in zip(*b)]
+    split["bukva"]["folds"]["fold1"] |= {"val": list(b[0][:3 * REC]), "test": list(b[0][3 * REC:])}
+    # корпус: Sohn сильнее SL-GCN — ветка продолжается; A1 и SL-GCN — одни логиты во всех затравках: все составы «нашей толпы»
+    # равны, вложенный выбор един (без «*», на котором стенд master падает — summary, разбор состава)
+    sk = {"Sohn": 2.5, "UzSohn": 2.8}
+    for f in SIG + ["other"]:
+        t = recs("u", [f], rng)
+        lg = logits(t[2], 0.8, rng)
+        for path in (v2 / "loso", v2 / "M12_slgcn_loso"):
+            for s in range(3):
+                mpk_run(path / f / f"seed{s}", cache, "V2", path.name, f, s, [(*t, np.full(len(t[0]), "test"), lg)])
+        for model, tag in (("Sohn", "uzsl_pre"),) + ((("UzSohn", "uzsohn_e1_uzsl_pre"),) if uz else ()):
+            for s in range(42, 47):
+                m13_run(runs / "UzSohn" / tag / f / f"seed{s}", *t, logits(t[2], sk[model], rng), uz if model == "UzSohn" else None)
+    if uz:  # итог Э2, как пишет turnir_e2_chain.sh: принятые рычаги (токены прогонов UzSohn) и маркер Э1 UzSohn
+        tok = list(uz["input"]) + [r for r, k in (("r2", uz["flags"].get("part_tokens")), ("r3", uz["ema"]), ("r4", uz["balanced"])) if k]
+        (runs / "UzSohn_E2.done").write_text(",".join(tok))
+        (runs / "UzSohn_E2_E1.done").touch()
+    for d in ("slovo", "bukva"):
+        for sub in ("splits", "cache/M13", "reports"):
+            (base / "OM" / sub).mkdir(parents=True, exist_ok=True)
+        (base / f"OM/splits/{d}_p5.json").write_text(json.dumps(split[d]))
+        np.savez(base / f"OM/cache/M13/{d}.npz", clips=np.array(json.dumps(clips[d])))
+
+
+def point(set_, base: Path) -> None:
+    root = base / "OM"
+    for k, v in dict(ROOT=root, UZ=base / "uzsign_ai_v2", RUNS=root / "runs", OUT=root / "runs/TURNIR", PRED=root / "runs/TURNIR/preds",
+                     M10C=[root / "runs/M10/cache", base / "uzsign_ai_v2/runs/M10/cache"]).items():
+        set_(k, v)
+
+
+def run_stand(mod):
+    """Что зовёт цепочка после M13 и в конце Э1 (кроме check — его тело не менялось): export, stoprule, summary, пары."""
+    for c in mod.C:
+        mod.export_cell(c, 1)
+    mod.stoprule()
+    mod.summary(0.99)
+    return mod.pairs_table(mod.MAIN_PAIRS, True), mod.pairs_table(mod.REF_PAIRS, False)
+
+
+def snapshot(out: Path) -> dict:
+    snap = {}
+    for p in sorted(out.rglob("*")):
+        if p.suffix == ".npz":
+            with np.load(p) as z:
+                snap[p.relative_to(out)] = {k: z[k] for k in z.files}
+        elif p.is_file():
+            snap[p.relative_to(out)] = p.read_bytes()
+    return snap
+
+
