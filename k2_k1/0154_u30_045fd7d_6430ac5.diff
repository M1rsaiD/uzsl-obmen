+def test_pass_order_parts_and_determinism():
+    """Порядок — основа порядка m13_train.Stream (default_rng([затравка, 7]).permutation), части по 64, неполная — нет."""
+    train = list(range(10, 160))
+    o1 = U.pass_order(train, 48, 64)
+    assert o1 == U.pass_order(train, 48, 64) and [len(p) for p in o1] == [64, 64]       # неполная часть (22) — нет
+    flat = sum(o1, [])
+    assert len(set(flat)) == 128 and set(flat) <= set(train) and U.pass_order(train, 7, 64) != o1
+    assert flat == np.random.default_rng([48, 7]).permutation(train)[:128].tolist()
+
+
+def test_bn_parts_aug_deterministic():
+    rng = np.random.default_rng(0)
+    recs = [(rng.uniform(0.2, 0.8, (T, sohn.NUM_NODES, 2)).astype(np.float32), np.zeros((T, 4), bool)) for T in range(20, 60)]
+    order = U.pass_order(list(range(len(recs))), 48, 16)
+    a, b = list(U.bn_parts(recs, order, 48, True)), list(U.bn_parts(recs, order, 48, True))
+    c = list(U.bn_parts(recs, order, 48, False))
+    assert len(a) == len(order) == 2 and all(x.shape[0] == 16 for x, _ in a)
+    assert all(torch.equal(x1, x2) and torch.equal(m1, m2) for (x1, m1), (x2, m2) in zip(a, b))
+    assert not any(torch.equal(x1, x3) for (x1, _), (x3, _) in zip(a, c))
+    assert torch.equal(c[0][0][0, :len(recs[order[0][0]][0])], torch.from_numpy(sohn.preprocess(recs[order[0][0]][0])))
+
