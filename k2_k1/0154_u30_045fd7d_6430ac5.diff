+"""U30 (scripts/uzsohn_u30_swa.py; Поправка 2 разд. 5) — без ГП и без данных: пересчёт MaskedBN — (i) сброс, (ii) равное среднее
+по частям прохода, (iii) смещённая дисперсия по шагам маски внутри части; равное среднее весов (11 одинаковых → last); update_bn
+MaskedBN не трогает; генераторы обучения и детерминизм прохода; отчёт — столбцы, дословная строка, файлы.
+CUDA_VISIBLE_DEVICES= PYTHONPATH=src python -m pytest -q tests/test_uzsohn_u30.py"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from mpk import sohn
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+import uzsohn_u30_swa as U  # noqa: E402
