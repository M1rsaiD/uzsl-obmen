+def test_swa_average_equal_mean_buffers_not_averaged():
+    sds = []
+    for s in range(3):
+        torch.manual_seed(s)
+        m = sohn.SohnNet(5)
+        for b in m.bns():
+            b.running_mean.fill_(s)
+            b.running_var.fill_(s + 1.0)
+        sds.append(m.state_dict())
+    avg = U.swa_average(sds)
+    assert list(avg) == list(sds[0])
+    for k, v in avg.items():
+        if k.endswith(U.RUNNING):
+            assert torch.equal(v, sds[-1][k])
+        else:
+            assert v.dtype == torch.float32 and torch.allclose(v, (sds[0][k] + sds[1][k] + sds[2][k]) / 3, atol=1e-7)
+    sohn.SohnNet(5).load_state_dict(avg)
+
