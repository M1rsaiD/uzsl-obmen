+def parts_synth(seed=0):
+    """3 части разного размера и длины со своим сдвигом среднего; у части записей половина шагов вне маски (там — мусор)."""
+    g = torch.Generator().manual_seed(seed)
+    out = []
+    for b, t, shift in ((4, 12, 0.0), (2, 3, 3.0), (6, 20, -2.0)):
+        x = torch.randn(b, t, sohn.CHANNELS, generator=g) + shift
+        m = torch.ones(b, t, dtype=torch.bool)
+        m[1:, t // 2:] = False
+        x[~m] = 1e3
+        out.append((x, m))
+    return out
+
+
+def stem_h(model, parts):
+    """Вход stem-BN по шагам маски каждой части — своей формулой (Masking + stem), не через MaskedBN."""
+    with torch.no_grad():
+        return [model.stem(x * m[..., None])[m] for x, m in parts]
+
+
+def test_recompute_bn_reset_equal_parts_biased_masked():
+    torch.manual_seed(0)
+    model = sohn.SohnNet(5)
+    parts = parts_synth()
+    for b in model.bns():
+        b.running_mean.fill_(5.0)
+        b.running_var.fill_(7.0)
+    assert U.recompute_bn(model, parts, seed=1) == 3
+    hs = stem_h(model, parts)
+    bn = model.stem_bn
+    assert torch.allclose(bn.running_mean, torch.stack([h.mean(0) for h in hs]).mean(0), atol=1e-5)
+    assert torch.allclose(bn.running_var, torch.stack([h.var(0, unbiased=False) for h in hs]).mean(0), rtol=1e-5, atol=1e-6)
+    pooled = torch.cat(hs)                                     # (ii): не по шагам маски; (iii): не общая и не несмещённая
+    assert not torch.allclose(bn.running_mean, pooled.mean(0), atol=1e-2)
+    assert not torch.allclose(bn.running_var, pooled.var(0, unbiased=False), rtol=1e-2)
+    assert not torch.allclose(bn.running_var, torch.stack([h.var(0, unbiased=True) for h in hs]).mean(0), rtol=1e-3)
+    assert not model.training and all(b.acc == {} for b in model.bns())
+    ref = {k: v.clone() for k, v in model.state_dict().items()}
+    for b in model.bns():                                      # (i): итог не зависит от прежних бегущих средних
+        b.running_mean.fill_(-3.0)
+        b.running_var.fill_(0.1)
+    U.recompute_bn(model, parts, seed=1)
+    assert all(torch.equal(ref[k], v) for k, v in model.state_dict().items())
+
+
+def test_recompute_bn_deterministic_dropout_as_training():
+    parts = parts_synth()
+
+    def run(seed):
+        torch.manual_seed(0)
+        model = sohn.SohnNet(5)
+        U.recompute_bn(model, parts, seed)
+        return {k: v for k, v in model.state_dict().items() if k.endswith(U.RUNNING)}
+
+    a, b, c = run(1), run(1), run(2)
+    assert all(torch.equal(a[k], b[k]) for k in a)
+    assert torch.equal(a["stem_bn.running_var"], c["stem_bn.running_var"])   # до первого dropout затравка не влияет
+    assert not all(torch.equal(a[k], c[k]) for k in a)                       # dropout в режиме обучения
+
