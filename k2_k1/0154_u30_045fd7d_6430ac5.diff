+def test_update_bn_skips_maskedbn():
+    """Посылка своего пересчёта (к3 0039 разд. 6): в SohnNet нет _BatchNorm, и torch.optim.swa_utils.update_bn буферы MaskedBN не
+    трогает (выходит до прохода по данным)."""
+    torch.manual_seed(0)
+    model = sohn.SohnNet(5)
+    for b in model.bns():
+        b.running_mean.fill_(5.0)
+        b.running_var.fill_(7.0)
+    ref = {k: v.clone() for k, v in model.state_dict().items()}
+    torch.optim.swa_utils.update_bn([(x, m) for x, m in parts_synth()], model)
+    assert not any(isinstance(m, torch.nn.modules.batchnorm._BatchNorm) for m in model.modules()) and len(model.bns()) == 11
+    assert all(torch.equal(ref[k], v) for k, v in model.state_dict().items())
+
