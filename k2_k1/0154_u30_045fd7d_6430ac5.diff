+def test_swa_eleven_identical_is_last():
+    torch.manual_seed(0)
+    sd = sohn.SohnNet(5).state_dict()
+    avg = U.swa_average([{k: v.clone() for k, v in sd.items()} for _ in range(11)])
+    assert all(torch.equal(avg[k], sd[k]) for k in sd)
