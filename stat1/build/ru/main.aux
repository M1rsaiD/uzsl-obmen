\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Модели по ключевым точкам по протоколу SD-5: точность top-1 и top-5, macro-усреднённые по классам точность (precision), полнота и $F_1$, парная разность top-1 с МПК-A1 (95~\% ДИ по тестовым исполнителям). Строки без пометки — три затравки $\times $ пять фолдов; † — оригинальный код или рецепт, одна затравка; * — общий рецепт без усреднения весов. Параметры и GFLOPs даны один раз, для моделей Slovo на окне проверки (32 кадра; 64 — трансформер по точкам; 150 — рецепт SL-GCN; 300 — ST-GCN с рецептом авторов); задержки на ЦП — в тексте.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:rsl_main}{{3}{10}{Модели по ключевым точкам по протоколу SD-5: точность top-1 и top-5, macro-усреднённые по классам точность (precision), полнота и $F_1$, парная разность top-1 с МПК-A1 (95~\% ДИ по тестовым исполнителям). Строки без пометки — три затравки $\times $ пять фолдов; † — оригинальный код или рецепт, одна затравка; * — общий рецепт без усреднения весов. Параметры и GFLOPs даны один раз, для моделей Slovo на окне проверки (32 кадра; 64 — трансформер по точкам; 150 — рецепт SL-GCN; 300 — ST-GCN с рецептом авторов); задержки на ЦП — в тексте}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Точность top-1 по SD-5 и объём вычислений на окно при проверке (логарифмическая шкала): (а) Slovo, (б) Bukva. Закрашенный круг — МПК-A1; незакрашенные — МПК-A2 и большая МПК; квадраты — базовые с общим рецептом (ST-GCN и SL-GCN — оригинальный код, только Slovo); ромбы — оригинальный код с рецептами авторов. Отрезки — 95~\% ДИ по исполнителям.}}{10}{figure.4}\protected@file@percent }
