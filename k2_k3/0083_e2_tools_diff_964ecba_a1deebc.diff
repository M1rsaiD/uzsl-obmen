--- a/scripts/turnir_e2_chain.sh
+++ b/scripts/turnir_e2_chain.sh
@@ -118,8 +118,9 @@ if [ ! -f runs/TURNIR_E2_OK ]; then
   hold_on
 fi
 say "жду 10 мин подряд без python на ГП (П11: идущие прогоны турнира не обрываются)"
-while true; do
-  while gpu_busy; do sleep 60; done
+n=0
+while true; do  # поправка к1 0151: раз в час — PID python на ГП (взаимная блокировка с held() видна в журнале в первый час)
+  while gpu_busy; do sleep 60; n=$((n + 1)); [ $((n % 60)) -eq 0 ] && say "жду ГП: python на ГП — PID $(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader | grep python | cut -d, -f1 | paste -sd' ')"; done
   ok=1; for i in $(seq 10); do sleep 60; gpu_busy && { ok=0; break; }; done
   [ $ok = 1 ] && break
 done
