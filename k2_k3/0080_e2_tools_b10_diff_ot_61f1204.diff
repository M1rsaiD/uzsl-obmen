 grep -q ЗАКРЫТА runs/TURNIR/stoprule.md && { say "правило остановки: ветка UzSohn ЗАКРЫТА — Э2 не начинается, UzSohn ≡ Sohn; выход"; exit 0; }
+# Б10 (к1 0149, к3 0048): хеш Э2 сверен к1 и к3 до конца M13 (runs/TURNIR_E2_PREOK, 1-я строка — полный хеш; пишет к2) → перемотку
+# master и runs/TURNIR_E2_OK делает цепочка — на ночном пути нет человека. Не master, правки в дереве, не fast-forward — обычный путь
+PH=$(head -1 runs/TURNIR_E2_PREOK 2> /dev/null | grep -oE '^[0-9a-f]{40}')
+if [ -n "$PH" ] && [ ! -f runs/TURNIR_E2_OK ]; then
+  if [ "$(git symbolic-ref -q --short HEAD)" = master ] && [ -z "$(git status --porcelain --untracked-files=no)" ] \
+     && git merge-base --is-ancestor HEAD "$PH" && git merge --ff-only -q "$PH" && [ "$(git rev-parse HEAD)" = "$PH" ]; then
+    echo "$PH" > runs/TURNIR_E2_OK && say "master перемотан на сверенный заранее $PH (runs/TURNIR_E2_PREOK, Б10); runs/TURNIR_E2_OK записан цепочкой"
+  else
+    say "!!! перемотка на $PH (runs/TURNIR_E2_PREOK) не прошла: не master, правки в дереве или не fast-forward — обычный путь"
+  fi
+fi
 say "правило остановки: ветка UzSohn продолжается; жду runs/TURNIR_E2_OK (не дольше 12 ч после UzSohn_M13.done)"
