   fi
+elif [ -f runs/TURNIR_E2_PREOK ] && [ ! -f runs/TURNIR_E2_OK ]; then   # Б10-д (к1 0150): иначе молча ждали бы 12 ч
+  say "!!! runs/TURNIR_E2_PREOK: в 1-й строке нет полного хеша (40 hex) — перемотки нет, обычный путь"
