+def test_cost_idle_sees_port(monkeypatch):
+    """Сеанс стоимости (П33, разд. 2 п. 8) — на простаивающей машине: процесс порта группы 3 (раннер зовёт его подпроцессом,
+    turnir_train.run_job) — занятость, как mpk.train и m13_train. Подставной процесс с той же командной строкой (exec -a), pgrep."""
+    import turnir_cost as tc
+    import turnir_train as tt
+    cmd = f"{sys.executable} {tt.PORT} --config runs/x/seed0.yaml --seed 0 --out runs/x/seed0"
+    p = subprocess.Popen(["bash", "-c", f'exec -a "{cmd}" sleep 30'])
+    try:
+        for _ in range(50):  # дождаться exec (командная строка — уже подставная)
+            if Path(f"/proc/{p.pid}/cmdline").read_bytes().startswith(cmd.encode()):
+                break
+            time.sleep(0.02)
+        monkeypatch.setattr(tc, "FORCE", False)
+        monkeypatch.setattr(tc.os, "getloadavg", lambda: (0.0, 0.0, 0.0))
+        with pytest.raises(AssertionError) as e:
+            tc.idle_or_die()
+        assert f"'{p.pid}'" in str(e.value), e.value
+    finally:
+        p.kill()
+        p.wait()
