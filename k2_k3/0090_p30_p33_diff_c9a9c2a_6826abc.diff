+def _g3_seed(runs: Path, seed: int, meta: dict | None, rel: str = "TURNIR/train/Slovo/Sohn/shared/scratch") -> Path:
+    """Каталог затравки в формате m13 (Slovo, fold1; по умолчанию — раннер группы 3): probs.npz + predictions.csv; metrics.json —
+    meta (None — не дописан)."""
+    d = runs / rel / f"fold1/seed{seed}"
+    d.mkdir(parents=True)
+    np.savez(d / "probs.npz", ids=np.array(["a", "b"]), probs=te.softmax16(np.eye(2)), classes=np.array(["c0", "c1"]))
+    (d / "predictions.csv").write_text("dataset,sample_id,signer_id,gloss,pred,correct,top5\nx,a,S01,c0,,,\nx,b,S01,c1,,,\n")
+    if meta is not None:
+        (d / "metrics.json").write_text(json.dumps(meta))
+    return d
