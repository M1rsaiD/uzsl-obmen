+def test_g3_pairs_macro_not_micro(tmp_path, monkeypatch):
+    """П30: Δ и вывод — по macro (micro — рядом), и у пар с явным рецептом, и у прежних (сторона — модель). Исполнители с разным
+    числом записей (4…58), навык зависит от их числа: macro ≠ micro (в синтетике build — поровну, там macro ≡ micro); ожидание —
+    счёт прямо по файлам, не кодом стенда."""
+    rng = np.random.default_rng(7)
+    cl = np.array([f"c{k}" for k in range(8)])
+    sig = [f"s{k:02d}" for k in range(10)]
+    n = {s: 4 + 6 * k for k, s in enumerate(sig)}
+    signer = np.array([s for s in sig for _ in range(n[s])])
+    ids = np.array([f"r{i:04d}" for i in range(len(signer))])
+    gloss = cl[rng.integers(0, len(cl), len(ids))]
+    for k, v in dict(PRED=tmp_path / "preds", RUNS=tmp_path / "runs", OUT=tmp_path / "out").items():
+        monkeypatch.setattr(te, k, v)
+    ok = {}
+    for model, seeds, skill in (("Sohn/native", range(42, 47), lambda s: 3.0 if n[s] > 30 else 0.3),
+                                ("Sohn/shared", range(5), lambda s: 1.5), ("SL-GCN/shared", range(5), lambda s: 0.3 if n[s] > 30 else 3.0)):
+        hit = defaultdict(list)  # запись → верно ли (по затравкам); одиночная — среднее по затравкам
+        for s in seeds:
+            for f in (0, 1):
+                k = np.arange(len(ids)) % 2 == f
+                lg = rng.normal(0, 1, (k.sum(), len(cl)))
+                lg[np.arange(k.sum()), np.searchsorted(cl, gloss[k])] += [skill(x) for x in signer[k]]
+                p = te.softmax16(lg)
+                te.save(te.PRED / "Slovo" / model / "scratch" / f"fold{f + 1}__seed{s}.npz", ids=ids[k], probs=p, classes=cl,
+                        signer=signer[k], gloss=gloss[k], role=np.full(k.sum(), "test"), run="синтетика")
+                for i, o in zip(ids[k], cl[p.astype(np.float32).argmax(1)] == gloss[k]):
+                    hit[i].append(float(o))
+        ok[model] = np.array([np.mean(hit[i]) for i in ids])
+
+    def mm(a, b):
+        d = ok[a] - ok[b]
+        return 100 * np.mean([d[signer == s].mean() for s in sig]), 100 * d.sum() / len(d)
+    t = te.pairs_table([("Slovo", ("Sohn", "native"), ("Sohn", "shared")), ("Slovo", ("Sohn", "shared"), ("SL-GCN", "shared")),
+                        ("Slovo", "Sohn", "SL-GCN")], False)
+    rows = [x.split(" | ") for x in t[2:]]
+    assert len(rows) == 5 and "↳ устойчивость" in rows[2][1] and "↳ устойчивость" in rows[4][1], t
+    for row, (a, b) in zip((rows[0], rows[1], rows[3]), (("Sohn/native", "Sohn/shared"), ("Sohn/shared", "SL-GCN/shared"),
+                                                         ("Sohn/native", "SL-GCN/shared"))):
+        mac, mic = mm(a, b)
+        assert f"{mac:+.2f}" != f"{mic:+.2f}"  # данные различают macro и micro
+        assert row[2] == f"{mac:+.2f}" and row[5].startswith(f"{mic:+.2f} ["), (row, mac, mic)
+    assert rows[2][2] == f"{mm('Sohn/shared', 'SL-GCN/shared')[0] + 2.71:+.2f}" and rows[4][2] == f"{mm('Sohn/native', 'SL-GCN/shared')[0] + 2.71:+.2f}"
+
