+@pytest.mark.parametrize("ds,name,ncls", [("Slovo", "slovo", 1001), ("Bukva", "bukva", 33), ("UzSL", "uzsl", 682)])
+def test_cost_g3_real_net(monkeypatch, ds, name, ncls):
+    """П33 на ЦП, на каждом наборе: сеть порта (SohnShared, Д-Т при T = 32, головы _Base на 2·dim) с головой своего набора (число
+    классов задано здесь, не NCLS стоимости) — GFLOPs графа вывода Deploy (логиты + вложение; больше одного кодировщика), задержка,
+    параметры — кодировщик + головы вывода (protos — только обучение); это не цена родного SohnNet (окно 47/61, classifier)."""
+    import turnir_cost as tc
+    import turnir_sohn_shared as ts
+    import turnir_train as tt
+    from torch.utils.flop_counter import FlopCounterMode
+    from mpk import sohn
+    from mpk.model import Deploy, param_counts
+    real = tc.bench
+    monkeypatch.setattr(tc, "bench", lambda fn: real(fn, 3))  # 3 замера вместо 100: проверка кода, не цена
+    c = next(c for c in te.C if G3(c) and c["ds"] == ds)
+    r = tc.sohn_shared_cell(c)
+    m = ts.SohnShared({**tt.SOHN_MODEL, "T": 32}, {name: ncls}).eval()
+    pc = param_counts(m)
+    x, mk = torch.randn(1, 32, sohn.CHANNELS), torch.ones(1, 32, dtype=torch.bool)
+
+    def gflops(fn):  # счётчик FLOPs детерминирован (по формам), веса не важны
+        with torch.no_grad(), FlopCounterMode(display=False) as fc:
+            fn()
+        return fc.get_total_flops() / 1e9
+    assert r["T"] == 32 and r["latency_ms"] > 0 and pc["train_only"] > 0
+    assert r["params_m"] == (pc["encoder"] + pc["inference_heads"]) / 1e6
+    assert r["gflops"] == gflops(lambda: Deploy(m, name)(x, mk, None)) > gflops(lambda: m.net(x, mk))
+    n = tc.sohn_cell(c)
+    assert n["T"] != 32 and n["params_m"] != r["params_m"] and abs(n["gflops"] - r["gflops"]) > 0.01
