+def test_e2_val_only_m13_loop(tmp_path, monkeypatch, capsys):
+    """--val-only на синтетике _tiny_run (валидация — записи 64…79, тест — 80…95). (а) Без флага main = main master бит в бит: набор
+    файлов, байты CSV и labels.json, массивы npz, веса, log.csv (без времени), значения metrics.json (без времени и ключей ветки: ema,
+    balanced, флаг part_tokens), последняя строка вывода (без шаг/с). (б) С флагом обучение то же (веса и log.csv = без флага); predict
+    — только на валидации (тест не предсказывается); выходы оценки — только *_val, по записям валидации; top1, top1_best, top1_last —
+    точность на валидации (= val_top1 лучшей и последней эпохи в log.csv); "score_on": "val" — в metrics.json и в последней строке
+    вывода (её печатает цепочка)."""
+    import csv
+    T_, base = _m13(), _sohn_at(MASTER_E2, "scripts/m13_train.py")
+    seen, line = [], {}
+    pred0 = T_.predict
+    monkeypatch.setattr(T_, "predict", lambda model, recs, labels, idx, *a: (seen.append(list(idx)), pred0(model, recs, labels, idx, *a))[1])
+    for name, mod, extra in (("master", base, ()), ("new", T_, ()), ("val", T_, ("--val-only",))):
+        seen.clear()
+        _tiny_run(mod, monkeypatch, tmp_path / name, *extra)
+        line[name] = json.loads(capsys.readouterr().out.splitlines()[-1])
+    a, b, c = (tmp_path / n for n in line)
+    files = lambda d: {p.name for p in d.iterdir()}
+    log = lambda d: [r[:-1] for r in csv.reader(open(d / "log.csv"))]       # без sec
+
+    def same(f, x, y):   # npz и .pt — по массивам (в zip — время записи)
+        if f.endswith(".npz"):
+            zx, zy = np.load(x / f), np.load(y / f)
+            return zx.files == zy.files and all(np.array_equal(zx[k], zy[k]) for k in zx.files)
+        if f.endswith(".pt"):
+            sx, sy = (torch.load(d / f)["model"] for d in (x, y))
+            return list(sx) == list(sy) and all(torch.equal(sx[k], sy[k]) for k in sx)
+        if f == "log.csv":
+            return log(x) == log(y)
+        return (x / f).read_bytes() == (y / f).read_bytes()
