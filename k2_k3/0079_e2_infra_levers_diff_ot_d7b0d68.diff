+def _e2_sel(tmp_path, monkeypatch):
+    """uzsohn_sel с RUNS, OUT, ROOT во временном каталоге; группы теста Slovo (splits/slovo_p5.json): a — 1, b — 2, c — 3."""
+    import sys
