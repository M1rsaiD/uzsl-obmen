+def _e2_put(S, suf, ok_a, ok_b, inp=(), extra=(), **over):
+    """10 ячеек прогона --val-only (выходы *_val, metrics.json — ключи m13_train): в каждой исполнитель a — 90 записей (ok_a
+    верных), b — 10 (ok_b); over — правка metrics.json, extra — лишние файлы в каталогах."""
+    import csv
+    for c in S.E2_CELLS:
+        s, f = c.split("/")
+        d = S.RUNS / f"uzsohn_e2_{s}_{suf}" / f / "seed48"
+        d.mkdir(parents=True)
+        r = [(f"{s}{i}", "a" if i < 90 else "b", int(i < ok_a or 90 <= i < 90 + ok_b)) for i in range(100)]
+        with open(d / "predictions_val.csv", "w", newline="", encoding="utf-8") as fh:
+            w = csv.writer(fh)
+            w.writerow(["dataset", "sample_id", "signer_id", "gloss", "pred", "correct", "top5"])
+            w.writerows([s, i, g, "x", "x" if ok else "y", ok, "x"] for i, g, ok in r)
+        top1 = sum(x[2] for x in r) / len(r)
+        u02 = {"train_examples": 600 * 512, "train_sohn_branch": 3072, "eval_records": 100, "eval_sohn_branch": 1}
+        m = {"set": s, "fold": f, "seed": 48, "score_on": "val", "top1": top1, "top1_last": top1, "init": None, "input": list(inp),
+             "variant": [], "flags": {"part_tokens": False, "cos_head": False}, "ema": False, "balanced": False, "steps": 600,
+             "steps_run": 600, "limit_train": 0, "epochs": 300, "stop_epoch": None, "channels": sohn.input_channels(inp),
+             "cfg": {"dim": 192, "batch_size": 512}, "params_keras_count": {"total": 1000 + len(s)},
+             "u02_sohn_branch": u02 if {"u02s", "u02c"} & set(inp) else None}
+        (d / "metrics.json").write_text(json.dumps(m | over))
+        for n in ("predictions_best_val.csv", "predictions_last_val.csv", "probs_val.npz", "logits_val.npz", *extra):
+            (d / n).touch()
