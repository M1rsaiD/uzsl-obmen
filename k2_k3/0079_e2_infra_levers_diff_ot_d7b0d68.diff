+    import uzsohn_sel as S
+    for k, v in (("RUNS", tmp_path / "runs"), ("OUT", tmp_path / "out"), ("ROOT", tmp_path)):
+        monkeypatch.setattr(S, k, v)
+    (tmp_path / "splits").mkdir()
