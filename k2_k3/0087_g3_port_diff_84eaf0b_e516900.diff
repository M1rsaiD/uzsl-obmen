+def test_model_d_t():
+    """T1 (П29): от SohnNet — stem, блоки, top (classifier → Identity, LateDropout выключен); головы _Base на 384, emb_dim 256,
+    emb_scale 16; layer_groups — 5 групп парами сверху по sohn_groups, не пусты, не пересекаются, с головами покрывают модель."""
+    import torch
+    import m13_train as mt
+    import turnir_sohn_shared as ts
+    from mpk.train import param_groups
+    torch.manual_seed(0)
+    m = ts.SohnShared({**tt.SOHN_MODEL, "T": 32}, {"a": 7, "b": 3})
+    assert isinstance(m.net.classifier, torch.nn.Identity) and not m.net.late_dropout_on and m.emb_scale == 16.0
+    assert m.heads["a"].in_features == 384 and m.emb.out_features == 256 and m.protos["b"].shape == (3, 256)
+    g9 = [[p for mod in g for p in mod.parameters()] for g in mt.sohn_groups(m.net)]
+    g5 = [[p for mod in g for p in mod.parameters()] for g in m.layer_groups()]
+    assert [len(g) for g in g5] == [len(g9[0]) + len(g9[1]), len(g9[2]) + len(g9[3]), len(g9[4]) + len(g9[5]),
+                                    len(g9[6]) + len(g9[7]), len(g9[8])] and all(g5)
+    pg, groups = param_groups(m, {"backbone_lr_mult": 0.1, "freeze_steps": 5}, 1e-3)
+    assert len(pg) == 6 and [g["lr"] for g in pg] == [1e-3] + [1e-4] * 5 and groups == m.layer_groups()
+    assert {n.split(".")[0] for n, p in m.named_parameters() if any(p is q for q in pg[0]["params"])} == {"heads", "emb", "protos"}
+    out = m(torch.randn(4, 32, 708), torch.ones(4, 32, dtype=torch.bool), None, (("a", 3), ("b", 1)))
+    assert [o["logits"].shape for o in out] == [(3, 7), (1, 3)]
