+"""
+
+
+def test_parent_has_no_torch_port_is_subprocess(tmp_path):
+    """Условие к1 0151 (22.1, П28–П33): plan((3,)) и run_job группы 3 в процессе раннера не импортируют torch (значит, контекста
+    CUDA у родителя нет — gpu_busy цепочки Э2 при придержке его не увидит); порт идёт подпроцессом той же командой, что
