+"""Турнир, группа 3 — Sohn в общем рецепте (порт (ii′), П28–П33 поправки 4; group3_port_design.md ред. 3, разд. 2.3, 5).
+
+cd osnovnaya_model && PYTHONPATH=src:../uzsign_e1/src python scripts/turnir_sohn_shared.py --config CFG --seed K --out DIR
+Запускает scripts/turnir_train.py run (run_job — подпроцессом, как mpk.train; сам раннер torch не импортирует). Конфиг —
+шаблон группы 1 той же ячейки и фолда (A1: родной рецепт = общий), меняется только блок model (turnir_train.swap_model).
+Определение Д-Т (П29): вход и предобработка — Sohn (cache/M13, 118 точек, sohn.preprocess) на окне T = 32 (окно и аугментации
+mpk.augment на 118 точках — как m13_train.a1_aug_sohn, но T из конфига, не длина записи); от SohnNet — stem, блоки, top,
+среднее по маске; classifier → Identity, LateDropout нет; головы mpk.baselines._Base на 2·dim; layer_groups — 5 парами сверху.
+Цикл — как mpk.train.run: AdamW, прогрев + косинус, param_groups, заморозка и разморозка сверху вниз (MaskedBN замороженных
+групп — в режиме вывода), EMA (ema_avg_fn, после commit_bn), best_val каждые eval_every или last (merge_val); S+B — две головы
+с долями пакета shares(), отбор — по среднему val голов.
+Выход (формат m13 — стенд выгружает без правок): best.pt, log.csv, metrics.json; при тесте — probs.npz, predictions.csv.
+Проверки до обучения: части разбиения не пересекаются, исполнители различны по data.disjoint, тест не в обучении; единая
+версия кода группы 3 (П32) — блобы G3_CODE в runs/TURNIR/g3_code.txt (первое задание пишет, каждое следующее сверяет).
+"""
+import argparse
+import csv
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+import yaml
+from torch.utils.data import DataLoader, Dataset
+
+from mpk import sohn
+from mpk.baselines import _Base
+from mpk.train import ema_avg_fn, load_init, param_groups, shares
+from uzsign_e1.train import lr_factor, sha256
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+import m13_build  # noqa: E402
+import m13_train as mt  # noqa: E402
+
+M13_DIR = ROOT / "cache/M13"  # кэш Sohn (118 точек), <набор>.npz
+SET = {"slovo": "slovo", "bukva": "bukva", "uzsl": "uzsl"}  # data.dataset шаблона → набор M13
+G3_CODE = ("src/mpk/sohn.py", "scripts/m13_train.py", "scripts/turnir_sohn_shared.py")  # П32 (+ сам скрипт порта)
+CODE_FILE = ROOT / "runs/TURNIR/g3_code.txt"
+
+
+def code_check(path: Path) -> dict:
+    """П32: первое задание группы 3 пишет блобы (git hash-object), каждое следующее сверяет; иначе — стоп до обучения."""
+    b = {p: subprocess.run(["git", "hash-object", str(ROOT / p)], capture_output=True, text=True, check=True).stdout.strip()
+         for p in G3_CODE}
+    if path.is_file():
+        old = json.loads(path.read_text())
+        assert old == b, f"!!! код группы 3 ≠ {path}: {old} против {b} — стоп до обучения (П32)"
+    else:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(b, indent=1))
+    return b
+
+
+def aug_t(x: np.ndarray, asp: float, aug: dict, rng: np.random.Generator, T: int) -> np.ndarray:
+    """= m13_train.a1_aug_sohn, но окно T кадров (Д-Т): индексы — mpk.augment.window(0, L, L, T, aug); выпадение кистей,
+    поворот, масштаб, сдвиг (y · H/W) и дрожание кистей — на T кадрах. При T = L — бит в бит a1_aug_sohn (тест).
+    П31: запись M13 = [lo, hi) — сдвиг границ наружу (Bukva) упирается в края записи, т. е. его нет."""
+    from mpk.augment import window
+    assert aug["window"] == "mpk" and aug["spatial"] == "mpk", aug
+    L = len(x)
+    one = lambda v: torch.tensor([v])
+    x = x[window(one(0), one(L), one(L), T, aug, torch.Generator().manual_seed(int(rng.integers(2 ** 62))))[0].numpy()].copy()
+    lo_p, hi_p = aug["p_hand_drop"]
+    drop = rng.random((T, 2)) < lo_p + rng.random() * (hi_p - lo_p)
+    m = np.zeros(x.shape[:2], bool)
+    m[:, sohn.LH_LOC], m[:, sohn.RH_LOC] = drop[:, :1], drop[:, 1:]
+    x[m] = np.nan
+    ang = (rng.random() * 2 - 1) * np.radians(aug["rot_deg"])
+    sc = aug["scale"][0] + rng.random() * (aug["scale"][1] - aug["scale"][0])
+    cs, sn = np.cos(ang) * sc, np.sin(ang) * sc
+    px, py = x[..., 0] - 0.5, (x[..., 1] - 0.5) * asp
+    sh = (rng.random(2) * 2 - 1) * aug["shift"]
+    px, py = cs * px - sn * py + sh[0], sn * px + cs * py + sh[1]
+    h = sohn.LH_LOC + sohn.RH_LOC
+    jit = rng.standard_normal((T, len(h), 2)) * aug["hand_jitter"]
+    px[:, h] += jit[..., 0]
+    py[:, h] += jit[..., 1]
+    return np.stack([px + 0.5, py / asp + 0.5], -1).astype(np.float32)
+
+
+class SohnShared(_Base):
+    """Sohn Д-Т (П29): stem + блоки + top + среднее по маске из SohnNet (classifier → Identity, LateDropout выключен),
+    головы _Base (heads, emb, protos) на 2·dim."""
+
+    def __init__(self, mc: dict, n_classes: dict[str, int]):
+        # shortcut: _Base требует ключи входа Н2 (eps, clip, in_channels) — у Sohn свой вход, mpk_input не вызывается
+        super().__init__(2 * mc["dim"], {**mc, "input": "mpk", "eps": 1e-3, "clip": 10.0, "in_channels": [0]}, n_classes)
+        self.net = sohn.SohnNet(1, mc["dim"])
+        self.net.classifier = torch.nn.Identity()
+
+    def encode(self, x, mask, aspect=None):
+        return (self.net(x, mask),)
+
+    def layer_groups(self) -> list[list]:
+        """5 групп парами сверху: {g8, g7}, {g6, g5}, {g4, g3}, {g2, g1}, {g0} по m13_train.sohn_groups (П29, ред. 3)."""
+        g = mt.sohn_groups(self.net)
+        assert len(g) == 9, len(g)
+        return [g[0] + g[1], g[2] + g[3], g[4] + g[5], g[6] + g[7], g[8]]
+
+
+def load_set(name: str, dc: dict, merge_val: bool) -> dict:
+    """Записи M13 + фолд шаблона; проверки — как mpk.train.prepare_set (части, покрытие, исполнители, тест вне обучения)."""
+    path = lambda p: Path(p) if Path(p).is_absolute() else ROOT / p
+    m13, cache, split = M13_DIR / f"{SET[dc['dataset']]}.npz", path(dc["cache"]), path(dc["split"])
+    c = m13_build.load(str(m13))
+    recs, clips = mt.Recs(c["xy"], c["absent"], c["offsets"]), c["clips"]
+    pos = {cl["sample_id"]: i for i, cl in enumerate(clips)}
+    assert len(pos) == len(clips), "повтор sample_id в кэше M13"
+    with np.load(cache, allow_pickle=False) as z:  # H/W записи — из кэша МПК шаблона (по sample_id)
+        asp = dict(zip((cl["sample_id"] for cl in json.loads(str(z["clips"]))), z["aspect"].astype(np.float32)))
+    fold = json.loads(split.read_text())["folds"][dc["fold"]]
+    idx = {r: np.array([pos[s] for s in fold[r]], np.int64) for r in ("train", "val", "test")}
+    used = np.concatenate(list(idx.values()))
+    has_test = dc.get("has_test", True)
+    assert len(np.unique(used)) == len(used), f"{name}: части пересекаются"
+    assert len(idx["train"]) and len(idx["val"]) and (len(idx["test"]) > 0) == has_test, (name, has_test)
+    assert dc["partial_split_ok"] or len(used) == len(pos), f"{name}: разбиение покрывает {len(used)} из {len(pos)} записей"
+    signer = np.array([cl["signer_id"] for cl in clips])
+    for a, b in dc["disjoint"]:
+        assert not set(signer[idx[a]]) & set(signer[idx[b]]), f"{name}: общие исполнители {a}∩{b}"
+    labels = sorted({clips[i]["gloss"] for i in used})
+    lab = {g: k for k, g in enumerate(labels)}
+    if merge_val:  # train ∪ val, val нет (mpk.train.prepare_set)
+        idx["train"], idx["val"] = np.concatenate([idx["train"], idx["val"]]), np.empty(0, np.int64)
+    assert not set(idx["train"]) & set(idx["test"]), "тест в обучении"
+    return {"name": name, "recs": recs, "clips": clips, "idx": idx, "labels": labels,
+            "y": np.array([lab.get(cl["gloss"], -1) for cl in clips], np.int64),
+            "asp": np.array([asp[cl["sample_id"]] for cl in clips], np.float32), "inputs": [m13, cache, split]}
+
+
+class Items(Dataset):
+    """(набор k, запись i, позиция) → (sohn.preprocess окна T [T, 708], метка); аугментация — от (затравка, позиция)."""
+
+    def __init__(self, S, augs, seed: int, T: int):
+        self.S, self.augs, self.seed, self.T = S, augs, seed, T
+
+    def __len__(self):
+        return sum(len(s["recs"]) for s in self.S)
+
+    def __getitem__(self, item):
+        k, i, pos = item
+        s = self.S[k]
+        x, _ = s["recs"][i]
+        if self.augs is not None:
+            x = aug_t(x, float(s["asp"][i]), self.augs[k], np.random.default_rng([self.seed, pos]), self.T)
+        else:
+            x = x[mt.a1_window(len(x), self.T)]  # проверка: T равномерных кадров (mpk.augment.window, aug=None)
+        return sohn.preprocess(x), int(s["y"][i])
+
+
+class Batches:
+    """Пакет — куски наборов подряд (доли share); у каждого — подряд случайные перестановки train, новая при исчерпании
+    (как mpk.train); один набор — бит в бит m13_train.EpochStream."""
+
+    def __init__(self, trains, share, steps: int, seed: int):
+        self.trains, self.share, self.steps, self.seed = trains, share, steps, seed
+
+    def __len__(self):
+        return self.steps
+
+    def __iter__(self):
+        rng, pos = np.random.default_rng([self.seed, 7]), 0
+        orders = [np.empty(0, np.int64) for _ in self.trains]
+        for _ in range(self.steps):
+            out = []
+            for k, (tr, n) in enumerate(zip(self.trains, self.share)):
+                if len(orders[k]) < n:
+                    orders[k] = np.concatenate([orders[k], rng.permutation(tr)])
+                b, orders[k] = orders[k][:n], orders[k][n:]
+                out += [(k, int(i), pos + j) for j, i in enumerate(b)]
+                pos += n
+            yield out
+
+
+def collate(items):
+    x, m = sohn.collate([a for a, _ in items])
+    return x, m, torch.tensor([b for _, b in items])
+
+
+@torch.no_grad()
+def infer(model, S, k: int, idx, T: int, dev, workers: int) -> np.ndarray:
+    model.eval()
+    dl = DataLoader(Items(S, None, 0, T), batch_size=256, collate_fn=collate, sampler=[(k, int(i), 0) for i in idx],
+                    num_workers=workers, multiprocessing_context=mt.FORK if workers else None)
+    out = []
+    for x, m, _ in dl:
+        with torch.autocast(dev.type, torch.bfloat16, enabled=dev.type == "cuda"):
+            out.append(model(x.to(dev), m.to(dev), None, S[k]["name"])["logits"].float().cpu().numpy())
+    return np.concatenate(out)
+
+
+def run(cfg: dict, seed: int, out: Path, max_steps: int | None, workers: int, code_file: Path) -> dict:
+    t0 = time.time()
+    mc, tc, lc, ft = cfg["model"], cfg["train"], cfg["loss"], cfg["finetune"]
+    assert mc["arch"] == "sohn_shared", mc["arch"]
+    assert tc["optimizer"] == "adamw" and not tc["refit_trainval"] and not cfg["synth"]["enabled"] \
+        and cfg["dominant"]["mode"] == "none" and tc["ema"] and tc["augment"], "вне общего рецепта турнира"
+    assert tc["select"] in ("best_val", "last"), tc["select"]
+    code = code_check(code_file)  # П32 — до данных и обучения
+    dcs = cfg["data"]["sets"] if "sets" in cfg["data"] else {cfg["data"]["dataset"]: cfg["data"]}
+    S = [load_set(n, dc, tc["merge_val"]) for n, dc in dcs.items()]
+    assert sum(len(s["idx"]["test"]) > 0 for s in S) <= 1, "тест — не больше чем у одного набора"
+    augs = []
+    for dc in dcs.values():  # сдвиг границ по набору (mpk.train.prepare_set)
+        a = dict(cfg["aug"])
+        if "boundary_inward_only" in dc:
+            assert a["boundary_inward_only"] == "per_set", "при data.sets сдвиг границ задаётся в каждом наборе"
+            a["boundary_inward_only"] = dc["boundary_inward_only"]
+        assert isinstance(a["boundary_inward_only"], bool), a["boundary_inward_only"]
+        augs.append(a)
+    out.mkdir(parents=True, exist_ok=False)
+    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    torch.manual_seed(seed)
+    multi, T, bs, steps = len(S) > 1, mc["T"], tc["batch_size"], tc["steps"]
+    share = shares([len(s["idx"]["train"]) for s in S], bs)
+    segs = tuple((s["name"], n) for s, n in zip(S, share))
+    model = SohnShared(mc, {s["name"]: len(s["labels"]) for s in S}).to(dev)
+    init = None if ft["init_from"] is False else load_init(model, ft["init_from"])
+    warmup = max(1, round(tc["warmup_frac"] * steps))
+    assert warmup < steps, (warmup, steps)
+    pg, groups = param_groups(model, ft, tc["lr"])
+    opt = torch.optim.AdamW(pg, lr=tc["lr"], weight_decay=tc["weight_decay"])
+    sched = torch.optim.lr_scheduler.LambdaLR(opt, lambda s: lr_factor(s, warmup, steps))
+    decay = tc["ema_decay"] if steps >= tc["ema_short_below"] else tc["ema_decay_short"]
+    ema = torch.optim.swa_utils.AveragedModel(model, multi_avg_fn=ema_avg_fn(decay, tc["ema_warmup"]), use_buffers=True)
+    ev = ema.module
+    ce = lambda lg, y: F.cross_entropy(lg.float(), y, label_smoothing=lc["label_smoothing"])
+
+    def seg_loss(r, y):  # = mpk.train.seg_loss (part_logits у _Base пуст)
+        loss = ce(r["logits"], y)
+        if lc["lambda_emb"]:
+            loss = loss + lc["lambda_emb"] * ce(r["emb_logits"], y)
+        if lc["beta_part"] and r["part_logits"]:
+            loss = loss + lc["beta_part"] * sum(ce(p, y) for p in r["part_logits"])
+        return loss
+
+    def save(step):
+        torch.save({"model": ev.state_dict(), "labels": {s["name"]: s["labels"] for s in S}, "step": step,
+                    "arch": mc["arch"]}, out / "best.pt")
+
+    last = steps if max_steps is None else min(steps, max_steps)
+    has_val, every = all(len(s["idx"]["val"]) for s in S), tc["eval_every"]
+    # shortcut: без torch.compile (MaskedBN копит моменты в dict Python — граф рвётся); на расписание и числа рецепта не влияет
+    dl = DataLoader(Items(S, augs, seed, T), batch_sampler=Batches([s["idx"]["train"] for s in S], share, last, seed),
+                    collate_fn=collate, num_workers=workers, prefetch_factor=2 if workers else None,
+                    multiprocessing_context=mt.FORK if workers else None, persistent_workers=workers > 0)
+    best, best_step, v1, loss_sum, n_sum, t_train, trace = -1.0, 0, float("nan"), 0.0, 0, 0.0, []
+    with open(out / "log.csv", "w", newline="") as flog:
+        log = csv.writer(flog)
+        log.writerow(["step", "lr", "train_loss", "val_top1", *([f"val_top1_{s['name']}" for s in S] if multi else []),
+                      "steps_per_s", "elapsed_s"])
+        ts = time.time()
+        for step, (x, m, y) in enumerate(dl, 1):
+            x, m, y = x.to(dev), m.to(dev), y.to(dev)
+            model.train()
+            fz = [k for k in range(len(groups)) if step <= ft["freeze_steps"] + k * ft["unfreeze_every"]]
+            for k in fz:  # замороженные группы: бегущие средние MaskedBN (у mpk.train — _BatchNorm)
+                for mod in groups[k]:
+                    for b in mod.modules():
+                        if isinstance(b, sohn.MaskedBN):
+                            b.eval()
+            model.net.set_pass(0)
+            with torch.autocast(dev.type, torch.bfloat16, enabled=dev.type == "cuda"):
+                if multi:
+                    rs = model(x, m, None, segs)
+                    loss = sum(n / bs * seg_loss(r, yy) for r, yy, n in zip(rs, torch.split(y, share), share))
+                else:
+                    loss = seg_loss(model(x, m, None, S[0]["name"]), y)
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            for k in fz:
+                for p in opt.param_groups[1 + k]["params"]:
+                    p.grad = None  # AdamW пропускает параметры без градиента (и weight decay тоже), как mpk.train
+            trace.append((step, [g["lr"] for g in opt.param_groups], fz))
+            lr = opt.param_groups[0]["lr"]
+            opt.step()
+            sched.step()
+            model.net.commit_bn()
+            ema.update_parameters(model)
+            loss_sum = loss_sum + loss.detach()  # без синхронизации ГП на каждом шаге (как mpk.train)
+            n_sum += 1
+            if step % every == 0 or step == last:
+                t_train += time.time() - ts
+                tl = float(loss_sum) / n_sum
+                assert np.isfinite(tl), f"loss = {tl} на шаге {step}"
+                v1s = [float((infer(ev, S, k, s["idx"]["val"], T, dev, workers).argmax(1) == s["y"][s["idx"]["val"]]).mean())
+                       for k, s in enumerate(S)] if has_val else []
+                v1 = float(np.mean(v1s)) if has_val else float("nan")
+                log.writerow([step, lr, tl, v1, *(v1s if multi else []), round(step / t_train, 2), round(time.time() - t0, 1)])
+                flog.flush()
+                loss_sum, n_sum = 0.0, 0
+                if has_val and v1 > best and tc["select"] == "best_val":  # контрольная точка — только по val
+                    best, best_step = v1, step
+                    save(step)
+                ts = time.time()
+    if not has_val or tc["select"] == "last":  # train ∪ val / select: last — веса последнего шага
+        best_step, best = last, (v1 if has_val else best)
+        save(last)
+    ev.load_state_dict(torch.load(out / "best.pt", map_location=dev)["model"])
+    res = {}
+    for k, s in enumerate(S):
+        te_ = s["idx"]["test"]
+        if len(te_):
+            lg = infer(ev, S, k, te_, T, dev, workers)
+            res["top1"] = mt.write_preds(out / "predictions.csv", s["name"], lg, te_, s["clips"], s["y"], s["labels"])
+            np.savez(out / "probs.npz", ids=np.array([s["clips"][i]["sample_id"] for i in te_]),
+                     probs=torch.from_numpy(lg).softmax(-1).numpy().astype(np.float16), classes=np.array(s["labels"]))
+    metrics = {**res, "best_step": best_step, "best_val_top1": best, "steps": steps, "steps_done": last, "max_steps": max_steps,
+               "batch_share": dict(segs), "train_steps_per_s": last / max(t_train, 1e-9), "init_from": init, "ema_decay": decay,
+               "n_groups": len(groups), "labels": {s["name"]: s["labels"] for s in S}, "seed": seed, "config": cfg,
+               "code_blobs": code, "device": torch.cuda.get_device_name(dev) if dev.type == "cuda" else "cpu",
+               "params_torch": sum(p.numel() for p in model.parameters()),
+               # только данные (разд. 3 п. 2 проекта): код — в code_blobs, иначе data_ok забраковал бы прогоны после правки скриптов
+               "inputs_sha256": {str(p): sha256(p) for s in S for p in s["inputs"]},
+               "prereg": "reports/TURNIR_prereg.md (поправка 4, П28–П33)", "wall_time_s": time.time() - t0}
+    (out / "metrics.json").write_text(json.dumps(metrics, ensure_ascii=False, indent=1))
+    return {**metrics, "trace": trace}
+
+
+def main(argv=None) -> dict:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--config", required=True)
+    ap.add_argument("--seed", type=int, required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--max-steps", type=int, help="обрыв после N шагов (дымовой тест); расписание lr не меняется")
+    ap.add_argument("--workers", type=int, default=6)
+    ap.add_argument("--code-file", default=str(CODE_FILE))
+    a = ap.parse_args(argv)
+    cfg = {**yaml.safe_load(Path(a.config).read_text()), "seed": a.seed}
