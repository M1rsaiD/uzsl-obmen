+def _m13(d: Path, name: str, signers, rng) -> list[str]:
+    """Синтетический кэш M13 (118 точек, NaN — нет точки) и кэш МПК (только clips, aspect) набора."""
+    clips, xs = [], []
+    for s in signers:
+        for i in range(8):
+            xs.append(rng.random((int(rng.integers(20, 45)), 118, 2)).astype(np.float32))
+            clips.append({"sample_id": f"{name}_{s}_{i}", "signer_id": s, "gloss": f"c{i % 4}"})
+    xy = np.concatenate(xs)
+    xy[rng.random(xy.shape[:2]) < 0.1] = np.nan
+    (d / "M13").mkdir(exist_ok=True)
+    np.savez(d / "M13" / f"{name}.npz", xy=xy, absent=np.zeros((len(xy), 4), bool),
+             offsets=np.concatenate([[0], np.cumsum([len(x) for x in xs])]).astype(np.int64),
+             fps_src=np.full(len(clips), 30.0, np.float32), clips=np.array(json.dumps(clips)), info=np.array("{}"))
+    np.savez(d / f"{name}_mpk.npz", clips=np.array(json.dumps([{"sample_id": c["sample_id"]} for c in clips])),
+             aspect=rng.uniform(0.5, 2.0, len(clips)).astype(np.float32))
+    return [c["sample_id"] for c in clips]
+
+
+def _split(d: Path, name: str, ids, parts: dict) -> Path:
+    p = d / f"{name}_{'_'.join(parts)}.json"
+    p.write_text(json.dumps({"folds": {fold: {r: [i for i in ids if i.split("_")[1] in sig] for r, sig in rs.items()}
+                                       for fold, rs in parts.items()}}))
+    return p
+
+
+def _cfg(d: Path, data: dict, steps: int, every: int, **kw) -> dict:
+    """Конфиг так, как его строит план группы 3: with_defaults(шаблон) → swap_model(…, «Sohn»)."""
+    tc = {"steps": steps, "eval_every": every, "batch_size": 16, "ema": True, **kw.pop("train", {})}
+    cfg = {"model": {"arch": "mpk", "T": 32}, "train": tc, "data": data, "aug": kw.pop("aug", {"boundary_inward_only": True}), **kw}
+    return tt.swap_model(tt.with_defaults(cfg), "Sohn")
+
