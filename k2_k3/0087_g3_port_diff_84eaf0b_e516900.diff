+"""Порт группы 3 (Sohn в общем рецепте, путь (ii′), П28–П33 поправки 4): план раннера, запуск подпроцессом без torch в
+родителе, окно и аугментации Д-Т, устройство модели, дымовые прогоны S+B → перенос и выгрузка стендом. Только синтетика.
+
+cd osnovnaya_model && CUDA_VISIBLE_DEVICES= PYTHONPATH=src:../uzsign_e1/src python -m pytest -q tests/test_turnir_sohn_shared.py
+torch на верхнем уровне не импортируется: модуль импортирует и проба «родитель без torch» (подпроцесс).
+"""
+import copy
+import json
+import os
+import subprocess
+import sys
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+import pytest
+import yaml
+
+OM = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(OM / "scripts"))
+import turnir_eval as te  # noqa: E402
+import turnir_train as tt  # noqa: E402
+
+STEPS = {("Slovo", "scratch"): 14488, ("Bukva", "scratch"): 2154, ("UzSL", "transfer"): 3802, ("UzSL", "scratch"): 26609}
+
+
+def templates(tmp: Path) -> tuple[Path, list]:
+    """Синтетические шаблоны группы 1: ячейки A1 (родной = общий рецепт) по фолдам и S+B A1 → (runs, te.C с их src)."""
+    runs, C = tmp / "runs", []
+    for c in te.C:
+        if c["model"] == tt.G3_TPL and c["recipe"] == "native":
+            tr, key = c["cond"] == "transfer", f"TPL/{c['ds']}_{c['cond']}"
+            for k, f in enumerate(te.FOLDS[c["ds"]]):
+                st = STEPS[(c["ds"], c["cond"])] + k  # у каждого фолда свой бюджет
+                cfg = {"seed": 1, "model": {"arch": "mpk", "T": 32, "d_model": 192},
+                       "train": {"steps": st, "eval_every": st // 20, "ema": True, "merge_val": c["ds"] == te.LO,
+                                 "select": "last" if c["ds"] == te.LO else "best_val"},
