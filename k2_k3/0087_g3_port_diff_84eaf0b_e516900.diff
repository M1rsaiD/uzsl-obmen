+def test_window_and_aug_d_t():
+    """T2: при T = L — бит в бит m13_train.a1_aug_sohn; при T = 32 без пространственных аугментаций — кадры
+    mpk.augment.window(0, L, L, 32, aug) того же генератора; пакеты одного набора = m13_train.EpochStream."""
+    import torch
+    import m13_train as mt
+    import turnir_sohn_shared as ts
+    from mpk.augment import window
+    rng = np.random.default_rng(0)
+    x = rng.random((40, 118, 2)).astype(np.float32)
+    x[rng.random((40, 118)) < 0.1] = np.nan
+    aug = {**tt.with_defaults({})["aug"], "boundary_inward_only": True}
+    np.testing.assert_array_equal(ts.aug_t(x, 1.3, aug, np.random.default_rng(3), 40),
+                                  mt.a1_aug_sohn(x, 1.3, aug, np.random.default_rng(3)))
+    neu = {**aug, "p_hand_drop": [0.0, 0.0], "rot_deg": 0.0, "scale": [1.0, 1.0], "shift": 0.0, "hand_jitter": 0.0}
+    a = ts.aug_t(x, 1.0, neu, np.random.default_rng(4), 32)
+    g = torch.Generator().manual_seed(int(np.random.default_rng(4).integers(2 ** 62)))
+    one = lambda v: torch.tensor([v])
+    idx = window(one(0), one(40), one(40), 32, neu, g)[0].numpy()
+    assert a.shape == (32, 118, 2) and len(set(idx)) > 1
+    np.testing.assert_allclose(a, x[idx], atol=1e-6)
+    S = [{"recs": [(x, None)], "asp": np.ones(1), "y": np.array([2])}]
+    e, y = ts.Items(S, None, 0, 32)[(0, 0, 0)]  # проверка: 32 равномерных кадра → sohn.preprocess, без аугментаций
+    np.testing.assert_array_equal(e, ts.sohn.preprocess(x[mt.a1_window(40, 32)]))
+    assert y == 2 and e.shape == (32, 708)
+    b = [[(i, p) for _, i, p in s] for s in ts.Batches([np.arange(10, 30)], [8], 7, 5)]
+    assert b == list(mt.EpochStream(list(range(10, 30)), 7, 5, 8))
